+#[cfg(test)]
+mod latency_tests {
+    use super::*;
+    use ash::vk::Handle;
+    use std::sync::atomic::{AtomicU64, Ordering};
+
+    static SERIAL: Mutex<()> = Mutex::new(());
+    static FREED: AtomicU64 = AtomicU64::new(0);
+
+    unsafe extern "system" fn free_memory(
+        _: vk::Device,
+        _: vk::DeviceMemory,
+        _: *const vk::AllocationCallbacks<'_>,
+    ) {
+        FREED.fetch_add(1, Ordering::Relaxed);
+    }
+
+    fn driver() -> ash::Device {
+        unsafe {
+            ash::Device::load_with(
+                |name| {
+                    if name.to_bytes() == b"vkFreeMemory" {
+                        free_memory as *const () as *const std::ffi::c_void
+                    } else {
+                        std::ptr::null()
+                    }
+                },
+                vk::Device::from_raw(1),
+            )
+        }
+    }
+
+    fn block(raw: u64, bytes: u64) -> Block {
+        Block {
+            memory: vk::DeviceMemory::from_raw(raw),
+            size: bytes,
+            mapped: None,
+            addresses: None,
+            imported: false,
+            pages: None,
+            view: None,
+            type_index: 0,
+        }
+    }
+
+    fn allocator() -> Memory {
+        let mut props = vk::PhysicalDeviceMemoryProperties {
+            memory_type_count: 1,
+            ..Default::default()
+        };
+        props.memory_types[0].property_flags = vk::MemoryPropertyFlags::DEVICE_LOCAL;
+        Memory::new(&props, 1 << 30, false, true, Vec::new(), None, None)
+    }
+
+    #[test]
+    fn surplus_pooled_image_backing_can_be_reused() {
+        let _serial = lock(&SERIAL);
+        FREED.store(0, Ordering::Relaxed);
+        let driver = driver();
+        let mut memory = allocator();
+        let pool = (Holds::Images, 0);
+        for raw in 1..=3 {
+            let index =
+                memory
+                    .pool(pool.0, pool.1)
+                    .add(64 << 20, false, block(raw, 64 << 20), 64 << 20);
+            memory.release_range(&driver, pool, index, 0, 64 << 20, None);
+        }
+        assert_eq!(FREED.load(Ordering::Relaxed), 0);
+        assert_eq!(memory.spare.len(), 1);
+        let reused = memory.take_spare(&driver, pool, 64 << 20).unwrap();
+        assert_eq!(reused.memory.as_raw(), 3);
+        unsafe {
+            reused.release(&driver);
+        }
+        drop(memory.destroy(&driver));
+        assert_eq!(FREED.load(Ordering::Relaxed), 3);
+    }
+
+    #[test]
+    fn image_spares_age_and_give_room() {
+        let _serial = lock(&SERIAL);
+        FREED.store(0, Ordering::Relaxed);
+        let driver = driver();
+        let mut memory = allocator();
+        let now = Instant::now();
+        for raw in 1..=5 {
+            memory.keep_spare(&driver, (Holds::Images, 0), block(raw, 64 << 20), now);
+        }
+        assert_eq!(memory.spare.len(), 5);
+        assert_eq!(FREED.load(Ordering::Relaxed), 0);
+        let room = memory.take_spare_for_room((Holds::Images, 0), 32 << 20).expect("spare");
+        assert_eq!(room.size, 64 << 20);
+        assert!(memory.take_spare_for_room((Holds::Images, 1), 1).is_none());
+        assert!(memory.take_spare_for_room((Holds::Images, 0), 128 << 20).is_none());
+        memory.keep_spare(&driver, (Holds::Images, 0), room, now);
+        memory.age_spare(&driver, now + SPARE_FOR);
+        assert!(memory.spare.is_empty());
+        drop(memory.destroy(&driver));
+    }
+}
