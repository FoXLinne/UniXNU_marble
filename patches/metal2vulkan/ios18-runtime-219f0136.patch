+fn prune_entry(
+    parts: &mut ModuleParts,
+    func: FuncId,
+    fcs: &HashMap<GlobalId, sccp::FcState>,
+    name: &DiagName,
+    m: &mut Meter,
+) -> Result<(), Error> {
+    if fcs.is_empty() || fcs.values().any(|state| !state.supplied) {
+        return Ok(());
+    }
+    let Some(entry) = parts.funcs.get_mut(func).and_then(|function| function.body.take()) else {
+        return Ok(());
+    };
+    let pruned = solve_entry(&entry, parts, fcs, name, m).and_then(|mut body| {
+        loop {
+            let (next, folded) = const_loads::fold(body, parts, m)?;
+            if !folded {
+                return Ok(next);
+            }
+            let solved = solve_entry(&next, parts, fcs, name, m);
+            next.release(m);
+            body = solved?;
+        }
+    });
