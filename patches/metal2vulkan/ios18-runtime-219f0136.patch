+        Ok(body) => { entry.release(m); body }
+        Err(error @ (Error::Budget(_) | Error::Cancelled | Error::LimitExceeded(_))) => return Err(error),
+        Err(_) => entry,
+    };
+    parts.funcs.get_mut(func).ok_or_else(|| invariant("entry out of range"))?.body = Some(kept);
+    Ok(())
