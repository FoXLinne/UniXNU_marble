+#[test]
+fn a_version_1_body_decodes_as_its_version_2_twin() {
+    let (v2, _, _) = located(|vst, entry| with_vst(Some(vst), entry));
+    let (v1, entry) = v1_good();
+    let t = decode(&v1).unwrap();
