+    let t = decode(&unnamed).unwrap();
+    assert!(t.fn_entries.is_empty());
+    let k = t.parts.funcs.get(FuncId::new(0)).unwrap();
+    assert_eq!(t.parts.symbols.get(k.name), Some(&b""[..]));
+    assert!(k.body.is_some());
