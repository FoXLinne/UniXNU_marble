+    /// Bytes allocated so far.
+    pub bytes: u64,
+    /// Allocations so far.
+    pub count: u64,
+    /// Return addresses, innermost first; 0 past the stack's end.
+    pub frames: [usize; SITE_FRAMES],
+}
+
+fn note_allocation_site(bytes: u64) {
+    if bytes < SITE_BYTES || !crate::stage_trace::diagnostics() {
+        return;
