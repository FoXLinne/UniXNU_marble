+/// Export aliases select their exact definition even when the same module contains
+/// several visible functions. The alias is part of the cache and function-table identity.
+#[test]
+fn specialized_names_resolve_exact_definitions_and_keys() {
+    let Some(caller) = fixture(CALLER) else {
+        return;
+    };
+    let Some(functions) = edited(FUNCTIONS, |text| {
+        text.replace("linked_scale", "source_scale")
+    }) else {
+        return;
+    };
+    let none = FunctionConstantValues::defaults();
+    let scale = LinkedSource::new("source_scale", &functions, &none);
+    let blend = LinkedSource::new("linked_blend", &functions, &none);
+    let offset = LinkedSource::new("linked_offset", &caller, &none);
+    assert_eq!(
+        compile_linked(&caller, &[scale, blend, offset], "moltenvk-m3").map(|_| ()),
+        Err(needs("linked_scale"))
+    );
+    let renamed = scale.with_specialized_name("linked_scale");
+    let p = profile("moltenvk-m3", DevicePolicy::default()).expect("profile");
+    let compiled =
+        compile_linked(&caller, &[renamed, blend, offset], "moltenvk-m3").expect("alias linked");
+    link_and_validate(&compiled, &p).expect("valid alias module");
+    let (_, module) =
+        typed_module_linked(&caller, CALLER, &p, &[renamed, blend, offset]).expect("module");
+    let buffer = |index| Buffer {
+        slot: Some(ResourceSlot {
+            stage: Stage::Kernel,
+            kind: ResourceKind::Buffer,
+            index,
+        }),
+        address: None,
+        bytes: vec![0; 32 * 4],
+    };
+    let out = run(
+        &module,
+        &Config {
+            workgroups: [32, 1, 1],
+            ..Config::default()
+        },
+        Resources {
+            buffers: vec![buffer(0), buffer(1)],
+            push: vec![0; 128],
+            spec: Default::default(),
+        },
+    )
+    .expect("execution");
+    for i in 0..32usize {
+        assert_eq!(
+            &out.buffers[0][i * 4..i * 4 + 4],
+            &(3 * i as u32 + (i as u32 & 7)).to_le_bytes()
+        );
+        assert_eq!(
+            &out.buffers[1][i * 4..i * 4 + 4],
+            &(i as f32 * 0.5 + 1.0).to_le_bytes()
+        );
+    }
+    let lib = Library::from_air(&functions).expect("library");
+    let f = LinkedFunction::new(lib.function("source_scale").expect("source"));
+    let a = f.clone().with_specialized_name(Some("a".into()));
+    let b = f.clone().with_specialized_name(Some("b".into()));
+    let linked = LinkedFunctions::new()
+        .with_function(a.clone())
+        .with_function(b.clone());
+    assert_ne!(linked.function_handle(&a), linked.function_handle(&b));
+    assert_eq!(linked.function_handle(&f), None);
+    let dev = device("moltenvk-m3");
+    let entry = Library::from_air(&caller)
+        .expect("caller")
