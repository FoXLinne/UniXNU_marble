+        WORKER_FREED.store(0, Ordering::Relaxed);
+        let driver = driver();
+        let mut memory = allocator();
+        unsafe {
+            assert!(memory
+                .let_go(&driver, block(1, 64 << 20), FreeCause::Dedicated, None)
+                .is_none());
+            assert!(memory
