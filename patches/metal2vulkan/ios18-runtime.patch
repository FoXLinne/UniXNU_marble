+    /// Something woke the scheduler's thread (id 0, `arg`: 0 commit, 1 completion, 2 host).
+    SchedulerWake = 21,
+    /// The scheduler's thread resumed after its sleep (id 0, `arg`: 1 timed out).
+    SchedulerResumed = 22,
