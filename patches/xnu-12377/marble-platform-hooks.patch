 }
 
+extern const char *native_marble_cellular_text_fixup(unsigned int);
+
 static void
 cs_text_fixup_init(void)
 {
+	for (unsigned int i = 0; ; i++) {
+		const char *entry = native_marble_cellular_text_fixup(i);
+		if (entry == NULL) {
+			break;
+		}
+		if (cs_text_fixup_count == CS_TEXT_FIXUP_MAX ||
+		    !cs_text_fixup_parse(entry, &cs_text_fixups[cs_text_fixup_count])) {
+			panic("Marble cellular text policy entry %u invalid", i);
+		}
+		cs_text_fixup_count++;
+	}
