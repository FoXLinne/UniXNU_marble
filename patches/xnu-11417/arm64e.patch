+#else /* CONFIG_SPTM */
+					value = (uintptr_t)pmap_sign_user_ptr((void *)value, key, discriminator, jop_key);
+					memcpy(rebaseLocation, &value, sizeof(value));
+#endif /* CONFIG_SPTM */
+				} else {
+					memcpy(rebaseLocation, &value, sizeof(value));
+				}
+#endif /* __has_feature(ptrauth_calls) */
