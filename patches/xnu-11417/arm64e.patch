+kern_return_t
+vm_shared_region_slide_part_v5(
+	vm_shared_region_slide_info_t si,
+	vm_offset_t vaddr,
+	__unused mach_vm_offset_t uservaddr,
+	uint32_t part,
+	uint32_t start,
+	bool apply,
+	uint32_t *next,
