+	adrp	\tmp, EXT(native_pac_keys)@page
+	add		\tmp, \tmp, EXT(native_pac_keys)@pageoff
+	ldr		\tmp2, [\tmp, #(NATIVE_PAC_KEY_WORDS * 8)]
+	cbnz	\tmp2, 2f
+	mrs		\tmp2, CNTPCT_EL0
+	MOV64	x3, 0x9e3779b97f4a7c15
+	MOV64	x4, 0xbf58476d1ce4e5b9
+	MOV64	x5, 0x94d049bb133111eb
+	mov		x2, #0
+1:
+	add		\tmp2, \tmp2, x3
+	eor		x6, \tmp2, \tmp2, lsr #30
+	mul		x6, x6, x4
+	eor		x6, x6, x6, lsr #27
+	mul		x6, x6, x5
+	eor		x6, x6, x6, lsr #31
+	str		x6, [\tmp, x2, lsl #3]
+	add		x2, x2, #1
+	cmp		x2, #(NATIVE_PAC_KEY_WORDS)
+	b.lo	1b
+	mov		x2, #1
+	str		x2, [\tmp, #(NATIVE_PAC_KEY_WORDS * 8)]
+	dsb		sy
+2:
+	ldp		x2, x3, [\tmp, #0]
+	msr		APIAKeyLo_EL1, x2
+	msr		APIAKeyHi_EL1, x3
+	ldp		x2, x3, [\tmp, #16]
+	msr		APIBKeyLo_EL1, x2
+	msr		APIBKeyHi_EL1, x3
+	ldp		x2, x3, [\tmp, #32]
+	msr		APDAKeyLo_EL1, x2
+	msr		APDAKeyHi_EL1, x3
+	ldp		x2, x3, [\tmp, #48]
+	msr		APDBKeyLo_EL1, x2
+	msr		APDBKeyHi_EL1, x3
+	ldp		x2, x3, [\tmp, #64]
+	msr		APGAKeyLo_EL1, x2
+	msr		APGAKeyHi_EL1, x3
+	isb		sy
+#endif /* HAS_NATIVE_PAC */
