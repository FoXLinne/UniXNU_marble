+#if HAS_NATIVE_PAC
+	/*
+	 * ARMv8.3 keys are shared by EL0 and EL1. The kernel and every process
+	 * use one key set per boot. The first CPU through here derives it from
+	 * the counter with splitmix64; every later entry, including warm resets,
+	 * loads the stored set. The MMU is off on this path, so the stores reach
+	 * memory and later CPUs read them there. Clobbers x2-x6.
