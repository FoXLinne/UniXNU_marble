+			uint16_t    diversity = (uint16_t)((value >> 34) & 0xFFFF);
+#endif /* __has_feature(ptrauth_calls) */
+			uint64_t    high8 = (value << 22) & 0xFF00000000000000ULL;
+			bool        isAuthenticated = (value & (1ULL << 63)) != 0;
