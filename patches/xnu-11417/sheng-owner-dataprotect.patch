+/*
+ * Data protection on a volume without content protection (a UniXNU owner Data volume is an unencrypted APFS volume, MNT_CPROTECT
+ * clear). APFS answers class 0 ("none") for every file there and keeps no class a caller sets, so a daemon that sets one and checks
+ * it back never sees it: PosterBoard creates its poster data store with NSFileProtectionNone (class D), finds the class missing,
+ * judges the store not viable and has no wallpaper. With boot-arg owner-dataprotect=1 a writable volume without content
+ * protection keeps the class a caller sets in an extended attribute, and a file without one reads as class D, which is what an
+ * unencrypted file is. Nothing is encrypted either way.
+ */
+#define NATIVE_DATAPROTECT_XATTR "com.unixnu.dataprotect-class"
+#define NATIVE_DATAPROTECT_CLASS_D 4
+
+static int
+native_dataprotect_emulated(vnode_t vp)
+{
+	static int enabled = -1;
+	if (enabled < 0) {
+		uint32_t value = 0;
+		enabled = PE_parse_boot_argn("owner-dataprotect", &value, sizeof(value)) && value == 1;
+	}
+	mount_t mp = vnode_mount(vp);
+	return enabled && mp != NULL && !(vfs_flags(mp) & MNT_CPROTECT) && !vfs_isrdonly(mp) &&
+	       (vnode_isreg(vp) || vnode_isdir(vp));
+}
+
+static void
+native_dataprotect_getattr(vnode_t vp, struct vnode_attr *vap, vfs_context_t ctx)
+{
+	uint32_t class = 0;
+	size_t size = sizeof(class);
+	uio_t uio = uio_create(1, 0, UIO_SYSSPACE, UIO_READ);
+	if (uio == NULL) {
+		return;
+	}
+	uio_addiov(uio, CAST_USER_ADDR_T(&class), sizeof(class));
+	if (vn_getxattr(vp, NATIVE_DATAPROTECT_XATTR, uio, &size, XATTR_NOSECURITY, ctx) != 0 || class == 0 || class > 7) {
+		class = NATIVE_DATAPROTECT_CLASS_D;
+	}
+	uio_free(uio);
+	vap->va_dataprotect_class = class;
+	VATTR_SET_SUPPORTED(vap, va_dataprotect_class);
+}
+
+/* Keeps the class asked for and takes it out of what the file system is asked to set (which would only drop it). */
+static void
+native_dataprotect_setattr(vnode_t vp, struct vnode_attr *vap, vfs_context_t ctx)
+{
+	uint32_t class = vap->va_dataprotect_class;
+	uio_t uio = uio_create(1, 0, UIO_SYSSPACE, UIO_WRITE);
+	if (uio == NULL) {
+		return;
+	}
+	uio_addiov(uio, CAST_USER_ADDR_T(&class), sizeof(class));
+	if (vn_setxattr(vp, NATIVE_DATAPROTECT_XATTR, uio, XATTR_NOSECURITY, ctx) == 0) {
+		VATTR_SET_SUPPORTED(vap, va_dataprotect_class);
+		VATTR_CLEAR_ACTIVE(vap, va_dataprotect_class);
+	}
+	uio_free(uio);
+}
