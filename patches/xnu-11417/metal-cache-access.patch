+/* Same-user shader artifacts use one persistent directory for every Metal client.
+ * Authorize that directory at the vnode boundary; ordinary UNIX ownership and
+ * mode checks still apply. Resolve vnodes rather than accepting a user path.
+ */
+static boolean_t
+native_metal_cache_path(vfs_context_t ctx, vnode_t vp, struct componentname *cnp)
+{
+	char path[MAXPATHLEN];
+	int length = sizeof(path);
+	uid_t uid = kauth_cred_getuid(vfs_context_ucred(ctx));
+	const char *root;
+	if (!vp || (uid != 0 && uid != 501) || vnode_vtype(vp) == VLNK) return FALSE;
+	if (vn_getpath(vp, path, &length)) return FALSE;
+	if (cnp) {
+		if (!cnp->cn_namelen || cnp->cn_namelen >= MAXPATHLEN ||
+		    memchr(cnp->cn_nameptr, '/', cnp->cn_namelen) ||
+		    (cnp->cn_namelen == 1 && cnp->cn_nameptr[0] == '.') ||
+		    (cnp->cn_namelen == 2 && !memcmp(cnp->cn_nameptr, "..", 2))) return FALSE;
+		size_t used = strlen(path);
+		if (used + 1 + cnp->cn_namelen >= sizeof(path)) return FALSE;
+		path[used++] = '/';
+		memcpy(path + used, cnp->cn_nameptr, cnp->cn_namelen);
+		path[used + cnp->cn_namelen] = 0;
+	}
+	const char *canonical = !strncmp(path, "/private/var/", 13) ? path + 8 : path;
+	root = uid == 501 ? "/var/mobile/Library/Caches/org.unixnu.metal" :
+	    "/var/root/Library/Caches/org.unixnu.metal";
+	size_t size = strlen(root);
+	return !strncmp(canonical, root, size) &&
+	    (!canonical[size] || canonical[size] == '/');
+}
