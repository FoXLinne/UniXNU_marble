+/* Reconstruct signature input from exact, configured text replacements.
+ * The executable page stays untouched. Bytes outside recognized replacements
+ * retain their current values so ordinary signature validation detects damage. */
+uint32_t
+cs_text_fixup_original_page(struct vnode *vp, memory_object_offset_t page_offset,
+    const void *kva, void *original)
+{
+	uint32_t matched = 0;
+	if (vp == NULLVP || vp->v_name == NULL) {
+		return 0;
+	}
+	if (original != NULL) {
+		memcpy(original, kva, PAGE_SIZE);
+	}
+	for (uint32_t i = 0; i < cs_text_fixup_count; i++) {
+		const struct cs_text_fixup *f = &cs_text_fixups[i];
+		if (f->offset < page_offset || f->offset - page_offset > PAGE_SIZE ||
+		    f->length > PAGE_SIZE - (f->offset - page_offset) ||
+		    strcmp(vp->v_name, f->name) != 0) {
+			continue;
+		}
+		size_t at = (size_t)(f->offset - page_offset);
+		if (memcmp((const uint8_t *)kva + at, f->replacement, f->length) != 0) {
+			continue;
+		}
+		if (original != NULL) {
+			memcpy((uint8_t *)original + at, f->original, f->length);
+		}
+		matched++;
+	}
+	return matched;
+}
