+extern "C" __attribute__((visibility("default"))) void tu_darwin_record_error(const char *file, int line, const char *message);
+extern "C" void tu_darwin_record_error(const char *file, int line, const char *message)
+{
+   if (darwin_startup_error[0]) return;
+   const char *name = strrchr(file, '/');
+   snprintf(darwin_startup_error, sizeof(darwin_startup_error), "%s:%d %s", name ? name + 1 : file, line, message);
+   if (dw.open) {
+      NativeAdrenoAbiMetadata meta = {};
+      snprintf(meta.text, sizeof(meta.text), "T %.61s", darwin_startup_error);
+      meta.bytes = strlen(meta.text);
+      (void)dw_call(NativeAdrenoMethodSetMetadata, &meta, sizeof(meta), NULL, 0);
+   }
+}
+extern "C" __attribute__((visibility("default"))) const char *tu_darwin_last_error(void);
+extern "C" const char *tu_darwin_last_error(void) { return darwin_startup_error; }
 
