+// Retained firmware and XNU share the DRAM map. Reserve the outside runs
+// before XNU adopts them, so firmware allocations after panic preserve them.
+STATIC ROOT_STAGE_DRAM_TABLE mRetainedDram;
+
+STATIC EFI_STATUS
+ReserveResidentDram (UINT8 *Table, UINTN Capacity, UINTN *Count, UINT64 *Bytes)
+{
+  EFI_GUID Guid=ROOT_STAGE_DRAM_GUID;
+  ROOT_STAGE_DRAM_TABLE *Existing=NULL;
+  for (UINTN Index=0; Index<gST->NumberOfTableEntries; Index++) {
+    if (CompareGuid(&Guid,&gST->ConfigurationTable[Index].VendorGuid))
+      Existing=gST->ConfigurationTable[Index].VendorTable;
+  }
+  if (Existing!=NULL) {
+    if (Existing->Magic!=ROOT_STAGE_DRAM_MAGIC || Existing->Version!=1 ||
+        Existing->Count>Capacity || Existing->Count>ROOT_STAGE_DRAM_RANGES) return EFI_COMPROMISED_DATA;
+    *Count=Existing->Count; *Bytes=0;
+    ZeroMem(Table,Capacity*16);
+    for (UINTN Index=0; Index<*Count; Index++) {
+      DarwinRangeSet(Table,Index,Existing->Range[Index].Base,Existing->Range[Index].Bytes);
+      *Bytes+=Existing->Range[Index].Bytes;
+    }
+    return EFI_SUCCESS;
+  }
+  if (*Count>ROOT_STAGE_DRAM_RANGES) return EFI_BAD_BUFFER_SIZE;
+  ZeroMem(&mRetainedDram,sizeof(mRetainedDram));
+  mRetainedDram.Magic=ROOT_STAGE_DRAM_MAGIC; mRetainedDram.Version=1;
+  for (UINTN Index=0; Index<*Count; Index++) {
+    EFI_PHYSICAL_ADDRESS Address=DarwinRangeBase(Table,Index);
+    UINT64 Size=DarwinRangeSize(Table,Index);
+    EFI_STATUS Status=gBS->AllocatePages(AllocateAddress,EfiLoaderData,EFI_SIZE_TO_PAGES(Size),&Address);
+    if (EFI_ERROR(Status)) {
+      // A firmware allocation may consume a candidate between map reads.
+      // The actual successfully reserved list is the VM ownership contract.
+      Print(L"DARWINBOOT: outside reservation 0x%lx + 0x%lx: %r\n",Address,Size,Status);
+      continue;
+    }
+    UINTN Slot=mRetainedDram.Count++;
+    mRetainedDram.Range[Slot].Base=Address; mRetainedDram.Range[Slot].Bytes=Size;
+  }
+  *Count=mRetainedDram.Count; *Bytes=0; ZeroMem(Table,Capacity*16);
+  for (UINTN Index=0; Index<*Count; Index++) {
+    DarwinRangeSet(Table,Index,mRetainedDram.Range[Index].Base,mRetainedDram.Range[Index].Bytes);
+    *Bytes+=mRetainedDram.Range[Index].Bytes;
+  }
+  return gBS->InstallConfigurationTable(&Guid,&mRetainedDram);
+}
