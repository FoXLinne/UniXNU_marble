 STATIC BOOLEAN mInterruptsSaved;
 STATIC UINT64 *mReturnTables;
 
+// The contiguous kernel span and the separately reserved outside runs have
+// the same VM owner. Firmware diagnostics may follow either after panic.
+STATIC BOOLEAN ResidentOwnedRange(UINT64 Address,UINTN Bytes,UINT64 Base,UINT64 Size)
+{
+  if (Address>=Base && Bytes<=Size && Address-Base<=Size-Bytes) return TRUE;
+  EFI_GUID Guid=ROOT_STAGE_DRAM_GUID;
+  for (UINTN Index=0;Index<gST->NumberOfTableEntries;Index++) {
+    if (!CompareGuid(&Guid,&gST->ConfigurationTable[Index].VendorGuid)) continue;
+    CONST ROOT_STAGE_DRAM_TABLE *Table=gST->ConfigurationTable[Index].VendorTable;
+    if (Table->Magic!=ROOT_STAGE_DRAM_MAGIC || Table->Version!=1 || Table->Count>ROOT_STAGE_DRAM_RANGES) return FALSE;
+    for (UINTN Range=0;Range<Table->Count;Range++) {
+      UINT64 From=Table->Range[Range].Base,Length=Table->Range[Range].Bytes;
+      if (Address>=From && Bytes<=Length && Address-From<=Length-Bytes) return TRUE;
+    }
+  }
+  return FALSE;
+}
