+STATIC VOID HandoffCheckpoint(UINT64 Video, UINT64 Bytes, UINT32 Stage)
+{
+  volatile UINT32 *Marker=(volatile UINT32 *)(UINTN)0xB7000000;
+  Marker[0]=0x484E4446; Marker[1]=Stage;
+  __asm__ volatile("dc cvac, %0\n\tdsb sy" :: "r"((UINTN)Marker) : "memory");
+  if (Video && Bytes>=4320*64) {
+    volatile UINT32 *Pixels=(volatile UINT32 *)(UINTN)Video;
+    for (UINTN I=0;I<1080*32;I++) Pixels[I]=0xFF000000U | (Stage*0x202010U);
+    for (UINTN I=Video;I<Video+4320*32;I+=64)
+      __asm__ volatile("dc cvac, %0" :: "r"(I) : "memory");
+    __asm__ volatile("dsb sy" ::: "memory");
+  }
+  Print(L"Handoff checkpoint %u\r\n",Stage);
+}
+
 EFI_STATUS DarwinResidentRun(ROOT_STAGE_TABLE *Stage, UINT64 Args, UINT64 Entry,
     UINT64 Base, UINT64 Size, UINT64 Video, UINT64 VideoBytes,
     EFI_MEMORY_DESCRIPTOR *Map, UINTN MapSize, UINTN Stride)
@@ -288,7 +303,9 @@
