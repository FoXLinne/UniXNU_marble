+// Passive handoff record in the loader-owned tail of the boot_args page.
+// One cache line stays readable through the resident USB memory export.
+STATIC VOID RecordHandoff(UINT64 Args, UINT64 Event, UINT64 Address)
+{
+  volatile UINT64 *Record=(VOID *)(UINTN)(Args+0x840);
+  UINT64 Counter;
+  __asm__ volatile("mrs %0, cntpct_el0" : "=r"(Counter));
+  Record[0]=0x31474F4C444E4148ULL; Record[1]=Event;
+  Record[2]=Address; Record[3]=Counter;
+  __asm__ volatile("dc cvac, %0\n\tdsb sy" :: "r"((UINTN)Record) : "memory");
+}
