                        }
                        Else
                        {
                            Return ("CLS08250")
                        }
                    }
                    ElseIf (((\_SB.SOID == 0x01E1) && (\_SB.PLST == One)))
                    {
                        Return ("CLS38250")
                    }
                    Else
                    {
