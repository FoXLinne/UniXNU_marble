+
+#define ROOT_STAGE_MAGIC 0x31544f4f52584e55ULL
+#define ROOT_STAGE_CHUNK 0x10000000ULL
+#define ROOT_STAGE_EXTENTS 64
+#define ROOT_STAGE_GUID {0x7db6a499,0x1639,0x46e7,{0xb2,0xca,0x28,0x5b,0x91,0xd0,0x6f,0x21}}
