++ * NativeTurnipSwapTest.h, swaptest4, device and imported host memory alike): a draw leaves its colour in tile memory in shader order (it
++ * reads back right through an input attachment), so with the identity swap on the memory side a GMEM pass stored drawn BGRA8 colour with
++ * red and blue exchanged (cc6633 for 3366cc) and loaded memory into tile memory in memory order (an input attachment read the loaded
++ * blue as red). The tile side stays the identity (tu_gmem_transfer_swap_fixup in r3d_dst_gmem). */
++static inline uint32_t
++tu_gmem_memory_side_info(uint32_t info)
++{
++   return info;
++}
