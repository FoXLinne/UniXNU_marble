   isb
+  // Preserve the final return frame, matching the marble HackiOS handoff.
+  mov x4, sp
+  sub x4, x4, #0x400
+  bic x4, x4, #63
+  add x5, x4, #0x4000
+4:
+  dc cvac, x4
+  add x4, x4, #64
+  cmp x4, x5
+  b.lo 4b
+  dsb sy
