+
+/* Pinned definitions, all from registers/adreno/a6xx.xml (dword register indices) and a6xx_preempt.c:
+ *   CP_CONTEXT_SWITCH_CNTL 0x08a0, CP_CONTEXT_SWITCH_SMMU_INFO 0x08a1, CP_CONTEXT_SWITCH_PRIV_NON_SECURE_RESTORE_ADDR 0x08a3,
+ *   RB_CONTEXT_SWITCH_GMEM_SAVE_RESTORE_ENABLE 0x8e50.
+ * The control word: STOP at bit 0, LEVEL at bits 6..7, USES_GMEM at bit 8, SKIP_SAVE_RESTORE at bit 9 (a6xx_cp_context_switch_cntl).
+ * a6xx_preempt_trigger writes LEVEL(1) | USES_GMEM | SKIP_SAVE_RESTORE | STOP with the incoming ring's SMMU info and record
+ * already programmed, and keeps the GPU awake with GMU_PWR_COL_PREEMPT_KEEPALIVE until a6xx_preempt_irq finds STOP cleared.
+ * A record's magic is A6XX_PREEMPT_RECORD_MAGIC 0xAE399D6E (a6xx_gpu.h) and the SMMU info's GEN7_CP_SMMU_INFO_MAGIC 0x241350d5. */
+enum : uint32_t {
+    PreemptCntl = 0x08a0,
+    PreemptSmmuInfo = 0x08a1,
+    PreemptRestoreAddr = 0x08a3,
+    PreemptGmemSaveRestore = 0x8e50,
+    CntlStop = 1u << 0,
+    CntlLevel1 = 1u << 6,
+    CntlUsesGmem = 1u << 8,
+    CntlSkipSaveRestore = 1u << 9,
+    RecordMagic = 0xAE399D6Eu,
+    SmmuInfoMagic = 0x241350d5u,
+    GmuPreemptKeepalive = 0x1f8c4,   /* a6xx_gmu.xml GMU_PWR_COL_PREEMPT_KEEPALIVE (dword offset in the GMU's window) */
+    RecordCntlOffset = 16,      /* magic, info, errno, data, cntl */
+    RecordRptrOffset = 20,
+    RecordWptrOffset = 24,
+    RecordRptrAddrOffset = 32,
+    RecordRbaseOffset = 40,
+    RecordCounterOffset = 48,
+    RecordBvRptrAddrOffset = 56
+};
+extern "C" {volatile uint32_t native_adreno_switch_log[NativeAdrenoSwitchLogRows][NativeAdrenoSwitchLogWords];volatile uint32_t native_adreno_switch_count;}
+enum : uint32_t {RegRbbmStatus=0x0210,RegRbbmInt0Status=0x0201,RegCpHwFault=0x0821,RegCpRbRptr=0x0806,RegCpRbWptr=0x0807};
+static void put32(uint8_t *at,uint32_t value)
+{
+    at[0]=(uint8_t)value;at[1]=(uint8_t)(value>>8);at[2]=(uint8_t)(value>>16);at[3]=(uint8_t)(value>>24);
+}
+static void put64(uint8_t *at,uint64_t value)
+{
+    put32(at,(uint32_t)value);put32(at+4,(uint32_t)(value>>32));
+}
+static uint32_t get32(const uint8_t *at)
+{
+    return uint32_t(at[0])|uint32_t(at[1])<<8|uint32_t(at[2])<<16|uint32_t(at[3])<<24;
+}
+bool NativeAdrenoPreempt::writeRecord(uint8_t *record,uint64_t rbase,uint64_t rptr_addr,uint64_t bv_rptr_addr,uint32_t cntl,uint32_t wptr)
+{
+    if(!record || !rbase || !rptr_addr)return false;
+    put32(record+0,RecordMagic);
+    put32(record+4,0);              /* info: written by the CP */
+    put32(record+8,0);              /* errno: written by the CP */
+    put32(record+12,0);             /* data: the YIELD and SET_MARKER payload, written by the CP */
+    put32(record+RecordCntlOffset,cntl);
+    put32(record+RecordRptrOffset,0);
+    put32(record+RecordWptrOffset,wptr);
+    put32(record+28,0);
+    put64(record+RecordRptrAddrOffset,rptr_addr);
+    put64(record+RecordRbaseOffset,rbase);
+    put64(record+RecordCounterOffset,0);   /* the preemption counters: 0 disables the block, as msm's A7XX rings do */
+    put64(record+RecordBvRptrAddrOffset,bv_rptr_addr);
+    return true;
+}
+bool NativeAdrenoPreempt::setRecordWptr(uint8_t *record,uint32_t wptr)
+{
+    if(!record)return false;
+    put32(record+RecordWptrOffset,wptr);
+    return true;
+}
+uint32_t NativeAdrenoPreempt::recordWord(const uint8_t *record,uint32_t byte_offset)
+{
+    return record&&byte_offset<64?get32(record+byte_offset):0;
+}
+uint32_t NativeAdrenoPreempt::recordWptr(const uint8_t *record)
+{
+    return record?get32(record+RecordWptrOffset):0;
+}
+bool NativeAdrenoPreempt::writeSmmuInfo(uint8_t *page,uint64_t ttbr0,uint32_t asid,uint32_t context_idr)
+{
+    if(!page || !ttbr0)return false;
+    put32(page+0,SmmuInfoMagic);
+    put32(page+4,0);
+    put64(page+8,ttbr0);
+    put32(page+16,asid);
+    put32(page+20,context_idr);
+    put32(page+24,0);               /* context_bank: the GPU's bank is 0 */
+    return true;
+}
+IOReturn NativeAdrenoPreempt::attach(const NativeAdrenoPreemptIo *io,const NativeAdrenoPreemptRings &rings,
+    uint32_t loaded,uint64_t (*now)(void *),void *clock)
+{
+    if(attached_)return kIOReturnBusy;
+    if(!io || !io->write32 || !io->read32 || !io->barrier)return kIOReturnBadArgument;
+    if(loaded>=NativeAdrenoPreemptRingCount)return kIOReturnBadArgument;
+    for(uint32_t i=0;i<NativeAdrenoPreemptRingCount;++i)
+        if(!rings.record[i] || !rings.smmu_info[i])return kIOReturnBadArgument;
+    io_=*io;rings_=rings;loaded_=loaded;next_=loaded;armed_=false;
+    now_us_=now;clock_cookie_=clock;
+    /* a6xx_preempt_hw_init: the GMEM save and restore on, the SMMU info zeroed (no switch in flight). */
+    if(io_.write32(io_.cookie,PreemptGmemSaveRestore,1) ||
+        io_.write32(io_.cookie,PreemptSmmuInfo,0) || io_.write32(io_.cookie,PreemptSmmuInfo+1,0) ||
+        io_.barrier(io_.cookie))return kIOReturnIOError;
+    attached_=true;
+    return kIOReturnSuccess;
+}
+IOReturn NativeAdrenoPreempt::detach()
+{
+    if(!attached_)return kIOReturnNotReady;
+    if(armed_)return kIOReturnBusy;
+    if(!releaseKeepalive())return kIOReturnIOError;
+    attached_=false;io_={};return kIOReturnSuccess;
+}
+/* Both rings' records as the CPU sees them: read pointer, write pointer, errno, info. */
+void NativeAdrenoPreempt::snapshot(volatile uint32_t *row,unsigned first) const
+{
+    __asm__ volatile("dsb sy":::"memory");
+    for(unsigned r=0;r<NativeAdrenoPreemptRingCount;++r) {
+        const uint8_t *rec=rings_.record_cpu[r];
+        row[first+r*4+0]=recordWord(rec,20);row[first+r*4+1]=recordWord(rec,24);
+        row[first+r*4+2]=recordWord(rec,8);row[first+r*4+3]=recordWord(rec,4);
+    }
+}
+volatile uint32_t *NativeAdrenoPreempt::openEvent(uint32_t to)
+{
+    const uint32_t n=native_adreno_switch_count;
+    volatile uint32_t *row=native_adreno_switch_log[n&(NativeAdrenoSwitchLogRows-1)];
+    for(unsigned i=0;i<NativeAdrenoSwitchLogWords;++i)row[i]=0;
+    const uint64_t now=now_us_?now_us_(clock_cookie_):0;
+    row[0]=n+1;row[1]=uint32_t(now);row[2]=uint32_t(now>>32);
+    row[5]=loaded_|to<<8;
+    snapshot(row,12);
+    native_adreno_switch_count=n+1;
+    return row;
+}
+void NativeAdrenoPreempt::closeEvent(uint32_t outcome)
+{
+    volatile uint32_t *row=event_;
+    if(!row)return;
+    const uint64_t now=now_us_?now_us_(clock_cookie_):0;
+    row[3]=uint32_t(now);row[4]=uint32_t(now>>32);
+    row[5]=(row[5]&0xffffu)|outcome<<16;
+    uint32_t v=0xffffffffu;
+    row[7]=readCntl();
+    row[8]=io_.read32(io_.cookie,RegRbbmStatus,&v)?0xffffffffu:v;v=0xffffffffu;
+    row[9]=io_.read32(io_.cookie,RegRbbmInt0Status,&v)?0xffffffffu:v;v=0xffffffffu;
+    row[10]=io_.read32(io_.cookie,RegCpHwFault,&v)?0xffffffffu:v;
+    uint32_t rptr=0xffff,wptr=0xffff;
+    if(!io_.read32(io_.cookie,RegCpRbRptr,&v))rptr=v&0xffff;
+    if(!io_.read32(io_.cookie,RegCpRbWptr,&v))wptr=v&0xffff;
+    row[11]=rptr|wptr<<16;
+    snapshot(row,20);
+    event_=nullptr;
+}
+void NativeAdrenoPreempt::noteTimeout(const uint32_t progress[6])
+{
+    if(!armed_ || !event_)return;
+    if(progress)for(unsigned i=0;i<6;++i)event_[28+i]=progress[i];
+    stats_.faulted++;
+    closeEvent(2);
+}
+bool NativeAdrenoPreempt::trigger(uint32_t ring,bool uses_gmem)
+{
+    if(!attached_ || armed_ || ring>=NativeAdrenoPreemptRingCount || ring==loaded_)return false;
+    /* Hold the GPU awake before programming any restore register. */
+    if(io_.gmu_write32 && io_.gmu_write32(io_.gmu_cookie,GmuPreemptKeepalive,1))return false;
+    keepalive_=true;
+    if(io_.barrier(io_.cookie)) {releaseKeepalive();return false;}
+    const uint64_t info=rings_.smmu_info[ring],record=rings_.record[ring];
+    event_=openEvent(ring);
+    if(io_.write32(io_.cookie,PreemptSmmuInfo,(uint32_t)info) ||
+        io_.write32(io_.cookie,PreemptSmmuInfo+1,(uint32_t)(info>>32)) ||
+        io_.write32(io_.cookie,PreemptRestoreAddr,(uint32_t)record) ||
+        io_.write32(io_.cookie,PreemptRestoreAddr+1,(uint32_t)(record>>32)))
+        {stats_.faulted++;closeEvent(3);releaseKeepalive();return false;}
+    if(io_.barrier(io_.cookie)) {stats_.faulted++;closeEvent(3);releaseKeepalive();return false;}
+    const uint32_t cntl=CntlStop|CntlLevel1|CntlSkipSaveRestore|(uses_gmem?CntlUsesGmem:0);
+    if(io_.write32(io_.cookie,PreemptCntl,cntl)) {stats_.faulted++;closeEvent(3);releaseKeepalive();return false;}
+    event_[6]=readCntl();
+    next_=ring;armed_=true;
+    trigger_us_=now_us_?now_us_(clock_cookie_):0;
+    stats_.triggers=stats_.triggers+1;
+    return true;
+}
+bool NativeAdrenoPreempt::timedOut(uint32_t limit_us) const
+{
+    if(!armed_ || !now_us_)return false;
+    return now_us_(clock_cookie_)-trigger_us_>limit_us;
+}
+uint32_t NativeAdrenoPreempt::readCntl() const
+{
+    uint32_t value=0xffffffffu;
+    if(attached_ && io_.read32)(void)io_.read32(io_.cookie,PreemptCntl,&value);
+    return value;
+}
+bool NativeAdrenoPreempt::complete()
+{
+    if(!attached_ || !armed_)return false;
+    uint32_t cntl=0;
+    if(io_.read32(io_.cookie,PreemptCntl,&cntl)) {stats_.faulted=stats_.faulted+1;return false;}
+    if(cntl&CntlStop)return false;
+    closeEvent(1);
+    loaded_=next_;armed_=false;
+    if(trigger_us_ && now_us_) {
+        const uint64_t us=now_us_(clock_cookie_)-trigger_us_;
+        stats_.last_us=uint32_t(us>UINT32_MAX?UINT32_MAX:us);
+    }
+    stats_.completed=stats_.completed+1;
+    return true;
+}
+
+bool NativeAdrenoPreempt::releaseKeepalive()
+{
+    if(!keepalive_)return true;
+    if(io_.gmu_write32 && io_.gmu_write32(io_.gmu_cookie,GmuPreemptKeepalive,0))return false;
+    keepalive_=false;return true;
+}
diff --git a/NativeAdrenoPreempt.h b/NativeAdrenoPreempt.h
new file mode 100644
index 0000000..d8951e3
--- /dev/null
+++ b/NativeAdrenoPreempt.h
@@ -0,0 +1,124 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef NATIVE_ADRENO_PREEMPT_H
+#define NATIVE_ADRENO_PREEMPT_H
+#include <IOKit/IOTypes.h>
+#include <stddef.h>
+#include <stdint.h>
+
+/* A6XX..A7XX CP context switch between two rings, as msm's a6xx_preempt.c drives it: the CP keeps one ring loaded and saves
+ * and restores the other's state through a preemption record the CPU fills in. Every constant below is from the pinned
+ * registers/adreno/a6xx.xml and a6xx_gpu.c/a6xx_preempt.c, never guessed:
+ *   CP_CONTEXT_SWITCH_CNTL 0x08a0 (STOP bit 0, LEVEL bits 6..7, USES_GMEM bit 8, SKIP_SAVE_RESTORE bit 9)
+ *   CP_CONTEXT_SWITCH_SMMU_INFO 0x08a1 (64 bit): the a7xx_cp_smmu_info the CP reads on the way in
+ *   CP_CONTEXT_SWITCH_PRIV_NON_SECURE_RESTORE_ADDR 0x08a3 (64 bit): the incoming ring's preemption record
+ *   RB_CONTEXT_SWITCH_GMEM_SAVE_RESTORE_ENABLE 0x8e50
+ *   GMU_PWR_COL_PREEMPT_KEEPALIVE: a6xx_gmu.xml dword offset 0x1f8c4 in the GMU's own register window
+ *   RBBM_INT_0_MASK bit 8 CP_SW: the switch finished
+ * A record is 4192 KiB (the CP stores its state there) and the SMMU info page 4 KiB; a6xx_preempt.c allocates exactly these
+ * per ring. A record's CPU-aware fields are the first 56 bytes (a6xx_preempt_record in a6xx_gpu.h).
+ *
+ * This object writes the trigger registers and judges the completion; the caller owns the memory (records, SMMU info pages,
+ * ring and fence pages), fills a record through writeRecord() and an SMMU info page through writeSmmuInfo(), and gives the
+ * write pointer again after a switch, because only it knows which ring the CP now runs. */
+enum : uint32_t {NativeAdrenoPreemptRingCount = 2};
+
+/* The GPU addresses of the per-ring state. */
+struct NativeAdrenoPreemptRings {
+    uint64_t record[NativeAdrenoPreemptRingCount];      /* the preemption record of each ring */
+    uint64_t smmu_info[NativeAdrenoPreemptRingCount];   /* the a7xx_cp_smmu_info page of each ring */
+    /* The CPU's own mappings of both, which the caller fills before each switch. */
+    uint8_t *record_cpu[NativeAdrenoPreemptRingCount];
+    uint8_t *smmu_cpu[NativeAdrenoPreemptRingCount];
+};
+
+struct NativeAdrenoPreemptIo {
+    void *cookie;
+    int (*write32)(void *, uint32_t reg, uint32_t value);
+    int (*read32)(void *, uint32_t reg, uint32_t *value);
+    int (*barrier)(void *);
+    /* The GMU's window: the preemption keepalive vote lives there, not in the GPU's register window. Its register is a dword index,
+     * as a6xx_gmu.xml writes it (0x1f8c4). */
+    void *gmu_cookie;
+    int (*gmu_write32)(void *, uint32_t dword_offset, uint32_t value);
+};
+
+struct NativeAdrenoPreemptStats {
+    uint32_t triggers;        /* switches the CPU asked for */
+    uint32_t completed;       /* switches whose STOP bit had cleared when the interrupt came */
+    uint32_t skipped;         /* a higher-priority ring was waiting and no switch was possible */
+    uint32_t faulted;         /* a switch that did not finish */
+    uint32_t disjoint_skips;  /* switches not taken because the rings' buffers overlap */
+    uint32_t restored_wptr;   /* write pointers given again after a switch */
+    uint32_t last_us;         /* how long the last completed switch took */
+};
+
+/* The newest 16 switches, one row each (words): [0] sequence, [1..2] trigger time (us), [3..4] end time (us, 0 pending), [5] from | to << 8 |
+ * outcome << 16 (0 pending, 1 done, 2 timed out, 3 a register write refused), [6] CP_CONTEXT_SWITCH_CNTL read right after the trigger,
+ * [7] the same at the end, [8] RBBM_STATUS, [9] RBBM_INT_0_STATUS and [10] CP_HW_FAULT at the end, [11] CP_RB_RPTR | CP_RB_WPTR << 16 at the
+ * end, [12..15] ring 0's record before the trigger and [16..19] ring 1's (read pointer, write pointer, errno, info), [20..27] both again at the
+ * end, [28..33] the CP's IB state when a switch timed out (NativeAdrenoRing::progressState). native_adreno_switch_count is the total. */
+enum : uint32_t {NativeAdrenoSwitchLogRows=16,NativeAdrenoSwitchLogWords=34};
+extern "C" volatile uint32_t native_adreno_switch_log[NativeAdrenoSwitchLogRows][NativeAdrenoSwitchLogWords];
+extern "C" volatile uint32_t native_adreno_switch_count;
+
+class NativeAdrenoPreempt final {
+    NativeAdrenoPreemptIo io_{};
+    NativeAdrenoPreemptRings rings_{};
+    uint32_t loaded_=0;   /* the ring the CP runs */
+    uint32_t next_=0;     /* the ring a switch in flight goes to */
+    bool armed_=false;    /* a switch was triggered and its STOP bit not yet seen cleared */
+    bool attached_=false,keepalive_=false;
+    uint64_t (*now_us_)(void *)=nullptr;
+    void *clock_cookie_=nullptr;
+    uint64_t trigger_us_=0;
+    NativeAdrenoPreemptStats stats_{};
+    volatile uint32_t *event_=nullptr;   /* the log row of the switch in flight */
+    void snapshot(volatile uint32_t *row,unsigned first) const;
+    volatile uint32_t *openEvent(uint32_t to);
+    void closeEvent(uint32_t outcome);
+public:
+    NativeAdrenoPreempt()=default;
+    ~NativeAdrenoPreempt()=default;
+    NativeAdrenoPreempt(const NativeAdrenoPreempt &)=delete;
+    NativeAdrenoPreempt &operator=(const NativeAdrenoPreempt &)=delete;
+    /* Programmes RB_CONTEXT_SWITCH_GMEM_SAVE_RESTORE_ENABLE and clears CP_CONTEXT_SWITCH_SMMU_INFO, as a6xx_preempt_hw_init
+     * does, with `loaded` the ring the CP runs. The caller must already own a powered GPU with that ring up. `now` times the
+     * switches (optional). */
+    IOReturn attach(const NativeAdrenoPreemptIo *,const NativeAdrenoPreemptRings &,uint32_t loaded,uint64_t (*now)(void *),void *clock);
+    IOReturn detach();
+    bool attached() const {return attached_;}
+    /* The CPU-aware fields of a record (a6xx_preempt_record, first 56 bytes): the magic the CP checks, the ring's address, its
+     * read-pointer shadow and BV read-pointer shadow, its CP_RB_CNTL value and the write pointer the CP resumes at. */
+    static bool writeRecord(uint8_t *record,uint64_t rbase,uint64_t rptr_addr,uint64_t bv_rptr_addr,uint32_t cntl,uint32_t wptr);
+    /* An a7xx_cp_smmu_info page: its magic, the page table the ring's CP runs, the address-space id and context idr. */
+    static bool writeSmmuInfo(uint8_t *page,uint64_t ttbr0,uint32_t asid,uint32_t context_idr);
+    /* The write pointer a record resumes at (the CP writes it back after saving), for the caller to give again. */
+    static uint32_t recordWptr(const uint8_t *record);
+    /* Before each switch only the write pointer is given again: the read pointer, the info and errno words are the CP's (it saves them
+     * into the record when it switches the ring out), so rewriting the whole record would send the ring back to its start. */
+    static bool setRecordWptr(uint8_t *record,uint32_t wptr);
+    static uint32_t recordWord(const uint8_t *record,uint32_t byte_offset);
+    /* Switch the CP to `ring`, which must not be the loaded one: its SMMU info and record go out first, then the control word
+     * with STOP. `uses_gmem` asks for the GMEM save and restore. False where a switch is still in flight or a register refused. */
+    bool trigger(uint32_t ring,bool uses_gmem);
+    /* The interrupt's side: read CP_CONTEXT_SWITCH_CNTL; a cleared STOP bit completes the switch and makes its ring the loaded
+     * one, a set one is still pending. False where nothing was in flight. */
+    bool complete();
+    /* Release the power vote after the incoming ring's WPTR is restored. */
+    bool releaseKeepalive();
+    bool inFlight() const {return armed_;}
+    uint32_t loaded() const {return loaded_;}
+    /* A switch triggered more than `limit_us` ago and still not complete. */
+    bool timedOut(uint32_t limit_us) const;
+    /* The switch in flight did not finish: the log row takes the CP's IB state (progress) and the registers, and the switch ends as timed out. */
+    void noteTimeout(const uint32_t progress[6]);
+    uint32_t readCntl() const;   /* CP_CONTEXT_SWITCH_CNTL as the hardware holds it (all ones when unreadable); STOP set means a switch is not done */
+    uint32_t target() const {return next_;}
+    /* After a GPU reset: `ring` is the one the CP runs and nothing is in flight. */
+    void restart(uint32_t ring) {loaded_=ring;armed_=false;event_=nullptr;releaseKeepalive();}
+    NativeAdrenoPreemptStats stats() const {return stats_;}
+    void noteDisjointSkip() {stats_.disjoint_skips=stats_.disjoint_skips+1;}
+    void noteSkipped() {stats_.skipped=stats_.skipped+1;}
+    void noteRestoredWptr() {stats_.restored_wptr=stats_.restored_wptr+1;}
+};
+#endif
diff --git a/NativeGpuLatency.h b/NativeGpuLatency.h
new file mode 100644
index 0000000..e736a52
--- /dev/null
+++ b/NativeGpuLatency.h
@@ -0,0 +1,41 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef NATIVE_GPU_LATENCY_H
+#define NATIVE_GPU_LATENCY_H
+#include <stdint.h>
+
+/* Runtime stages kept in the render server's frame trace: command, memory,
+ * completion and scheduling. */
+static inline bool native_gpu_latency_stage(uint32_t stage) {
+    return (stage >= 1 && stage <= 16) || (stage >= 40 && stage <= 57);
+}
+/* The kernel ring keeps GPU submission and retirement, display arrival, fence
+ * and latch, build identity, the render threads the CPU sampler follows,
+ * each process's Metal refusals (event 65, the text of what failed) and the
+ * render server's GMEM swap trace (Turnip passes 36, transfers 37, attachments
+ * 44; Turnip sends them only with SHENG_GPU_TRACE). */
+static inline bool native_gpu_latency_event(uint32_t event,const uint64_t *,uint32_t) {
+    switch(event) {
+    case 1:case 3:case 10:case 11:case 20:case 21:case 22:case 23:case 36:case 37:case 44:case 63:case 65:return true;
+    default:return false;
+    }
+}
+
+/* A pending display query retains transitions and a 100 ms heartbeat, plus the
+ * number of identical queries omitted. Completion is always retained. */
+struct NativeGpuLatencyWaits {
+    struct Slot {uint32_t busy=0,pid=0,reason=0;uint64_t request=0,target=0,when=0,omitted=0;};
+    Slot slots[32]{};
+    bool keep(uint64_t now,uint32_t pid,uint64_t request,uint32_t reason,uint64_t target,uint64_t &omitted) {
+        Slot &s=slots[(request ^ pid)&31];uint32_t free=0;
+        if(!__atomic_compare_exchange_n(&s.busy,&free,1,false,__ATOMIC_ACQUIRE,__ATOMIC_RELAXED))return true;
+        const bool same=s.request==request && s.pid==pid && s.target==target;
+        const bool pending=reason==3 || reason==4;
+        const bool emit=!pending || !same || s.reason!=reason || now-s.when>=100000;
+        if(emit) {
+            omitted=same?s.omitted:0;
+            s.pid=pid;s.request=request;s.target=target;s.reason=reason;s.when=now;s.omitted=0;
+        } else ++s.omitted;
+        __atomic_store_n(&s.busy,0,__ATOMIC_RELEASE);return emit;
+    }
+};
+#endif
diff --git a/NativeGpuPerfCounters.h b/NativeGpuPerfCounters.h
new file mode 100644
index 0000000..e61120c
--- /dev/null
+++ b/NativeGpuPerfCounters.h
@@ -0,0 +1,42 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef NATIVE_GPU_PERF_COUNTERS_H
+#define NATIVE_GPU_PERF_COUNTERS_H
+#include <stdint.h>
+/* A7XX BR counters from Mesa a6xx.xml and a7xx_perfcntrs.xml. Slots are reserved
+ * only with sheng-gpu-perf=1; selector readback detects another counter owner. */
+struct NativeGpuPerfCounter {uint32_t select,value,low;};
+static constexpr NativeGpuPerfCounter NativeGpuPerfPlan[]={
+ {0x08dd,0,0x031a}, /* CP_ALWAYS_COUNT, slot 13 */
+ {0x0e22,1,0x0382},{0x0e23,2,0x0384},{0x0e24,3,0x0386},
+ {0x0e25,4,0x0388},{0x0e26,8,0x038a},{0x0e27,9,0x038c},
+ {0xb619,0,0x03a0},{0xb61a,6,0x03a2},{0xb61b,7,0x03a4},
+ {0xae91,0,0x03c8},{0xae92,1,0x03ca},{0xae93,4,0x03cc},
+ {0xae94,40,0x03ce},{0xae95,51,0x03d0},{0xae96,52,0x03d2},{0xae97,101,0x03d4},
+ {0x8e2e,7,0x03f6},{0x8e2f,8,0x03f8}
+};
+enum {NativeGpuPerfCount=sizeof(NativeGpuPerfPlan)/sizeof(NativeGpuPerfPlan[0])};
+struct NativeGpuPerfSample {
+ uint64_t values[NativeGpuPerfCount]{};uint32_t mismatch=0,unstable=0,reset=0;bool first=false;
+};
+struct NativeGpuPerfCounters {
+ uint64_t previous[NativeGpuPerfCount]{};bool sampled=false;
+ template<class Write> void configure(Write write) const {
+  for(const auto &c:NativeGpuPerfPlan)write(c.select,c.value);
+ }
+ template<class Read> NativeGpuPerfSample capture(Read read) {
+  NativeGpuPerfSample out{};out.first=!sampled;
+  for(unsigned i=0;i<NativeGpuPerfCount;++i) {
+   const auto &c=NativeGpuPerfPlan[i];if(read(c.select)!=c.value)out.mismatch|=1u<<i;
+   bool stable=false;uint32_t lo=0,hi=0;
+   for(unsigned retry=0;retry<3;++retry) {
+    hi=read(c.low+1);lo=read(c.low);if(hi==read(c.low+1)){stable=true;break;}
+   }
+   if(!stable)out.unstable|=1u<<i;
+   out.values[i]=(uint64_t)hi<<32|lo;
+   if(sampled && out.values[i]<previous[i])out.reset|=1u<<i;
+   previous[i]=out.values[i];
+  }
+  sampled=true;return out;
+ }
+};
+#endif
