new file mode 100644
index 0000000..f7fe76e
--- /dev/null
+++ b/NativeGpuThreadTargets.h
@@ -0,0 +1,27 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef NATIVE_GPU_THREAD_TARGETS_H
+#define NATIVE_GPU_THREAD_TARGETS_H
+#include <stdint.h>
+/* Diagnostic thread identities by process and role (1 render, 2 encode,
+ * 3 completion). Writers publish the caller's own PID only. */
+struct NativeGpuThreadTargets {
+    struct Slot {uint64_t key;uint64_t tid;};
+    Slot slots[32]{};
+    static uint64_t keyOf(uint32_t pid,uint32_t role) {return (uint64_t)pid<<8|role;}
+    void record(uint32_t pid,uint32_t role,uint64_t tid) {
+        if(!pid || !role || role>255 || !tid)return;
+        const uint64_t key=keyOf(pid,role);
+        for(auto &slot:slots) {
+            uint64_t found=__atomic_load_n(&slot.key,__ATOMIC_ACQUIRE);
+            if(!found && !__atomic_compare_exchange_n(&slot.key,&found,key,false,__ATOMIC_ACQ_REL,__ATOMIC_ACQUIRE))continue;
+            if(!found || found==key){__atomic_store_n(&slot.tid,tid,__ATOMIC_RELEASE);return;}
+        }
+    }
+    uint64_t find(uint32_t pid,uint32_t role) const {
+        const uint64_t key=keyOf(pid,role);
+        for(const auto &slot:slots)if(__atomic_load_n(&slot.key,__ATOMIC_ACQUIRE)==key)
+            return __atomic_load_n(&slot.tid,__ATOMIC_ACQUIRE);
+        return 0;
+    }
+};
+#endif
diff --git a/NativeGpuTrace.h b/NativeGpuTrace.h
new file mode 100644
index 0000000..b940b56
--- /dev/null
+++ b/NativeGpuTrace.h
@@ -0,0 +1,50 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef NATIVE_GPU_TRACE_H
+#define NATIVE_GPU_TRACE_H
+#include <stdint.h>
+#include <stddef.h>
+
+/* Diagnostic ABI, independent of rendering policy. All times are uptime us.
+ * Event fields and joins are documented by scripts/decode-gpu-trace.py. */
+enum { NativeGpuTraceVersion=1, NativeGpuTraceNote=3, NativeGpuTraceMethod=0x7102,
+       NativeGpuTraceCapacity=65536, NativeGpuTraceMetadata=4096 };
+enum {
+    GpuTraceConfig=1, GpuTraceBuild=3,
+    GpuTraceSubmit=10, GpuTraceRetire=11,
+    GpuTraceDisplay=20, GpuTraceDisplaySurface=21, GpuTraceDisplayFence=22,
+    GpuTraceDisplayLatch=23, GpuTraceTurnipPass=36, GpuTraceTurnipGmemSide=37, GpuTraceTurnipAttachment=44,
+    GpuTraceThread=63, GpuTraceProblem=65
+};
+struct NativeGpuTraceRecord {
+    uint64_t sequence,us;
+    uint32_t event,pid;
+    uint64_t value[12];
+};
+struct NativeGpuTraceHeader {
+    uint32_t magic,version,record_bytes,count;
+    uint64_t issued,dropped;
+};
+#ifdef __cplusplus
+static_assert(sizeof(NativeGpuTraceRecord)==120,"GPU trace record ABI");
+extern "C" {
+#endif
+#ifdef NATIVE_GPU_TRACE_OPTIONAL
+#define NATIVE_GPU_TRACE_LINK __attribute__((weak_import))
+#else
+#define NATIVE_GPU_TRACE_LINK
+#endif
+int native_gpu_trace_enabled(void) NATIVE_GPU_TRACE_LINK;
+void native_gpu_trace_record(uint32_t event,uint32_t pid,const uint64_t *values,uint32_t count) NATIVE_GPU_TRACE_LINK;
+uint32_t native_gpu_trace_snapshot(void *out,uint32_t bytes);
+#ifdef __cplusplus
+}
+template<typename... T> static inline void gpuTraceEvent(uint32_t event,uint32_t pid,T... args) {
+#ifdef NATIVE_GPU_TRACE_OPTIONAL
+    if(!&native_gpu_trace_record)return;
+#endif
+    const uint64_t words[]={uint64_t(args)...};
+    native_gpu_trace_record(event,pid,words,sizeof...(args));
+}
+#endif
+#undef NATIVE_GPU_TRACE_LINK
+#endif
diff --git a/NativeGpuTrace.inc b/NativeGpuTrace.inc
new file mode 100644
index 0000000..7fdcc37
--- /dev/null
+++ b/NativeGpuTrace.inc
@@ -0,0 +1,71 @@
+#include "NativeGpuThreadTargets.h"
+#include "NativeGpuLatency.h"
+static NativeGpuLatencyWaits gpuLatencyWaits;
+static NativeGpuThreadTargets gpuThreadTargets;
+extern "C" uint64_t native_gpu_role_thread(uint32_t pid,uint32_t role) {return gpuThreadTargets.find(pid,role);}
+/* SPDX-License-Identifier: MIT */
+/* Included by the IOKit publisher; no allocation or GPU lock in a trace write. */
+#include "NativeGpuTraceStore.h"
+static NativeGpuTraceStore gpuTrace;
+static uint32_t gpuTraceOn;
+static NativeGpuTraceRecord *gpuMetadata;
+static uint32_t gpuMetadataBusy;
+static void gpuTraceInit()
+{
+    unsigned enabled=0;
+    PE_parse_boot_argn("sheng-gpu-trace",&enabled,sizeof(enabled));
+    if(enabled!=1)return;
+    gpuTrace.slots=static_cast<NativeGpuTraceSlot *>(IOMallocZero(sizeof(NativeGpuTraceSlot)*NativeGpuTraceCapacity));
+    if(!gpuTrace.slots)return;
+    gpuTrace.capacity=NativeGpuTraceCapacity;
+    gpuMetadata=static_cast<NativeGpuTraceRecord *>(IOMallocZero(sizeof(NativeGpuTraceRecord)*NativeGpuTraceMetadata));
+    __atomic_store_n(&gpuTraceOn,1,__ATOMIC_RELEASE);
+}
+extern "C" int native_gpu_trace_enabled(void) {return __atomic_load_n(&gpuTraceOn,__ATOMIC_ACQUIRE);}
+extern "C" void native_gpu_trace_record(uint32_t event,uint32_t pid,const uint64_t *values,uint32_t count)
+{
+    if(!native_gpu_trace_enabled() || count>12 || (count && !values) || !native_gpu_latency_event(event,values,count))return;
+    NativeGpuTraceRecord record{};uint64_t ns=0;
+    absolutetime_to_nanoseconds(mach_absolute_time(),&ns);
+    record.us=ns/1000;record.event=event;record.pid=pid;
+    for(uint32_t i=0;i<count;++i)record.value[i]=values[i];
+    if(event==22 && count>=9 && !gpuLatencyWaits.keep(record.us,pid,record.value[0],(uint32_t)record.value[1],record.value[2],record.value[9]))return;
+    record.sequence=gpuTrace.push(record);
+    if(event==GpuTraceThread && count>=2)gpuThreadTargets.record(pid,(uint32_t)record.value[1],record.value[0]);
+    const bool meta=event<=3 || event==GpuTraceThread || event==GpuTraceProblem;
+    uint32_t free=0;
+    if(meta && gpuMetadata && __atomic_compare_exchange_n(&gpuMetadataBusy,&free,1,false,__ATOMIC_ACQUIRE,__ATOMIC_RELAXED)) {
+        unsigned pick=NativeGpuTraceMetadata;
+        for(unsigned i=0;i<NativeGpuTraceMetadata;++i) {
+            auto &m=gpuMetadata[i];
+            if(!m.event && pick==NativeGpuTraceMetadata)pick=i;
+            if(m.event==event && m.pid==pid && (event!=GpuTraceThread || m.value[0]==record.value[0]) &&
+               (event!=GpuTraceProblem || !memcmp(m.value,record.value,sizeof m.value))){pick=i;break;}
+        }
+        if(pick<NativeGpuTraceMetadata)gpuMetadata[pick]=record;
+        else __atomic_add_fetch(&gpuTrace.dropped,1,__ATOMIC_RELAXED);
+        __atomic_store_n(&gpuMetadataBusy,0,__ATOMIC_RELEASE);
+    }
+
+}
+extern "C" uint32_t native_gpu_trace_snapshot(void *out,uint32_t bytes)
+{
+    if(!native_gpu_trace_enabled() || !out || bytes<sizeof(NativeGpuTraceHeader))return 0;
+    auto *header=static_cast<NativeGpuTraceHeader *>(out);
+    *header={0x31545047,NativeGpuTraceVersion,sizeof(NativeGpuTraceRecord),0,
+             __atomic_load_n(&gpuTrace.issued,__ATOMIC_ACQUIRE),__atomic_load_n(&gpuTrace.dropped,__ATOMIC_RELAXED)};
+    auto *records=reinterpret_cast<NativeGpuTraceRecord *>(header+1);
+    const uint32_t room=(bytes-sizeof(*header))/sizeof(*records);
+    uint32_t free=0;
+    if(gpuMetadata && __atomic_compare_exchange_n(&gpuMetadataBusy,&free,1,false,__ATOMIC_ACQUIRE,__ATOMIC_RELAXED)) {
+        for(unsigned i=0;i<NativeGpuTraceMetadata && header->count<room;++i)
+            if(gpuMetadata[i].event)records[header->count++]=gpuMetadata[i];
+        __atomic_store_n(&gpuMetadataBusy,0,__ATOMIC_RELEASE);
+    }
+    const uint64_t available=room-header->count;
+    const uint64_t keep=available<gpuTrace.capacity?available:gpuTrace.capacity;
+    const uint64_t first=header->issued>keep?header->issued-keep+1:1;
+    for(uint64_t n=first;n<=header->issued;++n)
+        if(gpuTrace.read(n,records+header->count))++header->count;
+    return sizeof(*header)+header->count*sizeof(*records);
+}
diff --git a/NativeGpuTraceStore.h b/NativeGpuTraceStore.h
new file mode 100644
index 0000000..a88af18
--- /dev/null
+++ b/NativeGpuTraceStore.h
@@ -0,0 +1,33 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef NATIVE_GPU_TRACE_STORE_H
+#define NATIVE_GPU_TRACE_STORE_H
+#include "NativeGpuTrace.h"
+
+/* Nonblocking writers and readers. A busy slot is dropped, never partly read.
+ * Storage is allocated once by the diagnostic owner, outside submission locks. */
+struct NativeGpuTraceSlot { uint32_t busy; NativeGpuTraceRecord record; };
+struct NativeGpuTraceStore {
+    NativeGpuTraceSlot *slots=nullptr;
+    uint32_t capacity=0;
+    uint64_t issued=0,dropped=0;
+    uint64_t push(NativeGpuTraceRecord record) {
+        if(!slots || !capacity)return false;
+        const uint64_t seq=__atomic_add_fetch(&issued,1,__ATOMIC_RELAXED);
+        auto &slot=slots[(seq-1)%capacity];uint32_t empty=0;
+        if(!__atomic_compare_exchange_n(&slot.busy,&empty,1,false,__ATOMIC_ACQUIRE,__ATOMIC_RELAXED)) {
+            __atomic_add_fetch(&dropped,1,__ATOMIC_RELAXED);return false;
+        }
+        // A delayed writer must not overwrite a newer lap of this slot.
+        if(slot.record.sequence<seq){record.sequence=seq;slot.record=record;}
+        else {__atomic_add_fetch(&dropped,1,__ATOMIC_RELAXED);__atomic_store_n(&slot.busy,0,__ATOMIC_RELEASE);return 0;}
+        __atomic_store_n(&slot.busy,0,__ATOMIC_RELEASE);return seq;
+    }
+    bool read(uint64_t seq,NativeGpuTraceRecord *out) {
+        if(!slots || !capacity || !seq || !out)return false;
+        auto &slot=slots[(seq-1)%capacity];uint32_t empty=0;
+        if(!__atomic_compare_exchange_n(&slot.busy,&empty,1,false,__ATOMIC_ACQUIRE,__ATOMIC_RELAXED))return false;
+        const bool found=slot.record.sequence==seq;if(found)*out=slot.record;
+        __atomic_store_n(&slot.busy,0,__ATOMIC_RELEASE);return found;
+    }
+};
+#endif
diff --git a/NativeGpuTraceTest.cpp b/NativeGpuTraceTest.cpp
new file mode 100644
index 0000000..60b8b61
--- /dev/null
+++ b/NativeGpuTraceTest.cpp
@@ -0,0 +1,54 @@
+// SPDX-License-Identifier: MIT
+// Host checks for the diagnostic store, with the allocation/clock boundary replaced.
+#include <cassert>
+#include <cstdlib>
+#include <cstring>
+#include <chrono>
+#include <thread>
+#include <vector>
+#include "NativeGpuTrace.h"
+static void PE_parse_boot_argn(const char *,unsigned *out,size_t){*out=1;}
+static void *IOMallocZero(size_t n){return calloc(1,n);}
+static uint64_t mach_absolute_time(){return std::chrono::steady_clock::now().time_since_epoch().count();}
+static void absolutetime_to_nanoseconds(uint64_t t,uint64_t *out){*out=t;}
+#include "NativeGpuTrace.inc"
+int main() {
+    NativeGpuThreadTargets targets;assert(targets.find(61,1)==0);targets.record(61,1,100);
+    targets.record(61,1,200);targets.record(61,2,250);targets.record(0,1,300);
+    assert(targets.find(61,1)==200);assert(targets.find(61,2)==250);assert(targets.find(0,1)==0);
+    gpuTraceInit();
+    uint64_t thread[6]={3456,1,0,0,0,0};native_gpu_trace_record(63,61,thread,6);
+    uint64_t encode[6]={3457,2,0,0,0,0};native_gpu_trace_record(63,61,encode,6);
+    assert(native_gpu_role_thread(61,1)==3456 && native_gpu_role_thread(61,2)==3457);
+
+    NativeGpuTraceSlot slots[8]{};NativeGpuTraceStore store;store.slots=slots;store.capacity=8;
+    for(unsigned i=0;i<32;++i){NativeGpuTraceRecord r{};r.value[0]=i;assert(store.push(r));}
+    NativeGpuTraceRecord row{};assert(!store.read(24,&row));assert(store.read(25,&row) && row.value[0]==24);
+    std::vector<std::thread> writers;
+    for(unsigned t=0;t<4;++t)writers.emplace_back([&,t]{for(unsigned i=0;i<10000;++i){NativeGpuTraceRecord r{};r.pid=t;r.value[0]=i;r.value[1]=~uint64_t(i);store.push(r);}});
+    for(auto &t:writers)t.join();
+    for(uint64_t i=store.issued-7;i<=store.issued;++i)if(store.read(i,&row))assert(row.value[1]==~row.value[0]);
+    gpuTraceInit();gpuTraceEvent(GpuTraceBuild,0,1234);
+    for(unsigned i=0;i<NativeGpuTraceCapacity+10;++i)gpuTraceEvent(GpuTraceSubmit,7,i);
+    std::vector<uint8_t> output(32+(NativeGpuTraceCapacity+NativeGpuTraceMetadata)*120);
+    unsigned bytes=native_gpu_trace_snapshot(output.data(),output.size());assert(bytes>32);
+    auto *head=(NativeGpuTraceHeader *)output.data();auto *rows=(NativeGpuTraceRecord *)(head+1);
+    bool build=false;for(unsigned i=0;i<head->count;++i)build|=rows[i].event==GpuTraceBuild && rows[i].value[0]==1234;
+    assert(build);
+    auto issued=gpuTrace.issued;
+    uint64_t noise[3]={123,53,0};
+    for(uint32_t event:{12u,13u,14u,15u,38u,39u,43u,61u,62u,64u,68u})native_gpu_trace_record(event,61,noise,3);
+    assert(gpuTrace.issued==issued);
+    native_gpu_trace_record(GpuTraceRetire,61,noise,3);assert(gpuTrace.issued==issued+1);
+    /* The render server's GMEM swap trace: Turnip passes, transfers and attachments. */
+    for(uint32_t event:{36u,37u,44u})native_gpu_trace_record(event,61,noise,3);
+    assert(gpuTrace.issued==issued+4);
+    NativeGpuLatencyWaits waits;uint64_t omitted=0;
+    assert(waits.keep(1,0,55,3,99,omitted));
+    for(unsigned i=2;i<100001;++i)assert(!waits.keep(i,0,55,3,99,omitted));
+    assert(waits.keep(100002,0,55,3,99,omitted) && omitted==99999);
+    assert(waits.keep(100003,0,55,4,99,omitted));
+    assert(waits.keep(100004,0,55,1,99,omitted));
+    assert(waits.keep(100005,0,55,3,100,omitted));
+    return 0;
+}
