index 0000000..6298926
--- /dev/null
+++ b/NativeTurnipSwapTest.h
@@ -0,0 +1,397 @@
+// SPDX-License-Identifier: MIT
+// GMEM colour order test (boot-arg sheng-swaptest=1, once, in the render server): which byte order each path between tile memory and
+// memory leaves in a linear BGRA8 image, rendered in system memory and in GMEM. The image is 3048 x 64, as wide as the render server's
+// surface (3048 is not a whole number of GMEM blocks, so an imported image takes the unpadded load and store paths). Two kinds: device memory,
+// and host memory imported (as an IOSurface's pages are). Its memory starts as B=10 G=20 R=30 A=255 in every pixel; one render pass that loads
+// and stores it then does, by region (the scissor):
+//   A  x    0..1015  a draw of R=0.8 G=0.4 B=0.2 (stored bytes should read 33 66 cc as B G R)
+//   B  x 1016..2031  nothing (the load and the store: 0a 14 1e)
+//   C  x 2032..3047, rows  0..31  the input attachment's red written as grey (the loaded red, 30: 1e 1e 1e)
+//   D  x 2032..3047, rows 32..63  the draw of A, then the input attachment's red as grey (the drawn red, 204: cc cc cc)
+// Each kind and mode sends one line through the GPU trace (event 65): "swap <kind><mode> A<bgr> B<bgr> C<bgr> D<bgr> m<passes> e<err>".
+// The image is filled and read back by GPU copies through a host-coherent buffer: imported pages are mapped non-coherent for the GPU, so CPU
+// writes and reads of them saw stale cache lines (swaptest2: the system memory pass's draw missing from host memory).
+// The mode is set for this thread only (tu_sheng_set_thread_render_mode: 's' system memory, 'g' GMEM where the pass can).
+#pragma once
+#include "NativeTurnipSmoke.h"
+#include "NativeTurnipShaders.h"
+#include <stdlib.h>
+
+#pragma clang diagnostic push
+#pragma clang diagnostic ignored "-Wmissing-field-initializers"
+namespace turnip {
+namespace swaptest {
+
+constexpr uint32_t kWidth = 3048, kHeight = 64;
+
+struct Fns {
+    PFN_vkGetImageSubresourceLayout vkGetImageSubresourceLayout = nullptr;
+    PFN_vkCmdSetScissor vkCmdSetScissor = nullptr;
+    PFN_vkCmdSetViewport vkCmdSetViewport = nullptr;
+    PFN_vkGetMemoryHostPointerPropertiesEXT vkGetMemoryHostPointerPropertiesEXT = nullptr;
+    PFN_vkCmdCopyBufferToImage vkCmdCopyBufferToImage = nullptr;
+};
+
+struct Target {
+    VkImage image = nullptr;
+    VkDeviceMemory memory = nullptr;
+    VkImageView view = nullptr;
+    uint8_t *bytes = nullptr;   // the image's memory as the CPU sees it
+    void *host = nullptr;       // the imported allocation (host kind)
+    VkDeviceSize pitch = 0;
+};
+
+static void destroy(Device &d, Target &t) {
+    if (t.view) d.vkDestroyImageView(d.device, t.view, nullptr);
+    if (t.image) d.vkDestroyImage(d.device, t.image, nullptr);
+    if (t.memory) {
+        if (!t.host) d.vkUnmapMemory(d.device, t.memory);
+        d.vkFreeMemory(d.device, t.memory, nullptr);
+    }
+    free(t.host);
+    t = Target();
+}
+
+// 0 or the failing step.
+static int makeTarget(Device &d, Fns &f, bool hostKind, Target &t) {
+    VkExternalMemoryImageCreateInfo external = {VK_STRUCTURE_TYPE_EXTERNAL_MEMORY_IMAGE_CREATE_INFO};
+    external.handleTypes = VK_EXTERNAL_MEMORY_HANDLE_TYPE_HOST_ALLOCATION_BIT_EXT;
+    VkImageCreateInfo ic = {VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO};
+    ic.pNext = hostKind ? &external : nullptr;
+    ic.imageType = VK_IMAGE_TYPE_2D;
+    ic.format = VK_FORMAT_B8G8R8A8_UNORM;
+    ic.extent = {kWidth, kHeight, 1};
+    ic.mipLevels = 1;
+    ic.arrayLayers = 1;
+    ic.samples = VK_SAMPLE_COUNT_1_BIT;
+    ic.tiling = VK_IMAGE_TILING_LINEAR;
+    ic.usage = VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT | VK_IMAGE_USAGE_INPUT_ATTACHMENT_BIT | VK_IMAGE_USAGE_TRANSFER_SRC_BIT;
+    ic.initialLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+    if (d.vkCreateImage(d.device, &ic, nullptr, &t.image) != VK_SUCCESS) return 1;
+    VkImageSubresource sub = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0};
+    VkSubresourceLayout layout = {};
+    f.vkGetImageSubresourceLayout(d.device, t.image, &sub, &layout);
+    t.pitch = layout.rowPitch;
+    VkMemoryRequirements req = {};
+    d.vkGetImageMemoryRequirements(d.device, t.image, &req);
+    VkMemoryAllocateInfo mai = {VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO};
+    VkImportMemoryHostPointerInfoEXT import = {VK_STRUCTURE_TYPE_IMPORT_MEMORY_HOST_POINTER_INFO_EXT};
+    if (hostKind) {
+        if (!f.vkGetMemoryHostPointerPropertiesEXT) return 2;
+        const size_t size = (req.size + 16383) & ~size_t(16383);
+        if (posix_memalign(&t.host, 16384, size) || !t.host) return 2;
+        VkMemoryHostPointerPropertiesEXT props = {VK_STRUCTURE_TYPE_MEMORY_HOST_POINTER_PROPERTIES_EXT};
+        if (f.vkGetMemoryHostPointerPropertiesEXT(d.device, VK_EXTERNAL_MEMORY_HANDLE_TYPE_HOST_ALLOCATION_BIT_EXT, t.host, &props) !=
+            VK_SUCCESS) return 3;
+        import.handleType = VK_EXTERNAL_MEMORY_HANDLE_TYPE_HOST_ALLOCATION_BIT_EXT;
+        import.pHostPointer = t.host;
+        mai.pNext = &import;
+        mai.allocationSize = size;
+        mai.memoryTypeIndex = d.memoryType(req.memoryTypeBits & props.memoryTypeBits, 0);
+        t.bytes = static_cast<uint8_t *>(t.host);
+    } else {
+        mai.allocationSize = req.size;
+        mai.memoryTypeIndex = d.memoryType(req.memoryTypeBits, VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT | VK_MEMORY_PROPERTY_HOST_COHERENT_BIT);
+    }
+    if (mai.memoryTypeIndex == UINT32_MAX) return 4;
+    if (d.vkAllocateMemory(d.device, &mai, nullptr, &t.memory) != VK_SUCCESS) return 5;
+    if (d.vkBindImageMemory(d.device, t.image, t.memory, 0) != VK_SUCCESS) return 6;
+    if (!hostKind) {
+        void *mapped = nullptr;
+        if (d.vkMapMemory(d.device, t.memory, 0, VK_WHOLE_SIZE, 0, &mapped) != VK_SUCCESS || !mapped) return 7;
+        t.bytes = static_cast<uint8_t *>(mapped) + layout.offset;
+    } else {
+        t.bytes += layout.offset;
+    }
+    VkImageViewCreateInfo vc = {VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO};
+    vc.image = t.image;
+    vc.viewType = VK_IMAGE_VIEW_TYPE_2D;
+    vc.format = ic.format;
+    vc.subresourceRange = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1};
+    return d.vkCreateImageView(d.device, &vc, nullptr, &t.view) == VK_SUCCESS ? 0 : 8;
+}
+
+// One pass over target t in the thread's render mode; 0 or the failing step (20 and up).
+static int renderOnce(Device &d, Fns &f, Target &t, HostBuffer &upload, HostBuffer &staging) {
+    for (uint32_t i = 0; i < kWidth * kHeight; ++i) upload.words[i] = 0xff1e140au;   // B=0a G=14 R=1e A=ff
+    for (uint32_t i = 0; i < kWidth * kHeight; ++i) staging.words[i] = 0;
+    VkRenderPass pass = nullptr;
+    VkFramebuffer framebuffer = nullptr;
+    VkShaderModule vs = nullptr, fsConst = nullptr, fsFetch = nullptr;
+    VkDescriptorSetLayout setLayout = nullptr;
+    VkPipelineLayout layout = nullptr;
+    VkPipeline drawPipe = nullptr, fetchPipe = nullptr;
+    VkDescriptorPool pool = nullptr;
+    int failed = 0;
+    do {
+        VkAttachmentDescription attachment = {0, VK_FORMAT_B8G8R8A8_UNORM, VK_SAMPLE_COUNT_1_BIT, VK_ATTACHMENT_LOAD_OP_LOAD,
+                                              VK_ATTACHMENT_STORE_OP_STORE, VK_ATTACHMENT_LOAD_OP_DONT_CARE, VK_ATTACHMENT_STORE_OP_DONT_CARE,
+                                              VK_IMAGE_LAYOUT_GENERAL, VK_IMAGE_LAYOUT_GENERAL};
+        VkAttachmentReference color = {0, VK_IMAGE_LAYOUT_GENERAL}, input = {0, VK_IMAGE_LAYOUT_GENERAL};
+        VkSubpassDescription subpass = {};
+        subpass.pipelineBindPoint = VK_PIPELINE_BIND_POINT_GRAPHICS;
+        subpass.inputAttachmentCount = 1;
+        subpass.pInputAttachments = &input;
+        subpass.colorAttachmentCount = 1;
+        subpass.pColorAttachments = &color;
+        VkSubpassDependency deps[2] = {
+            {0, 0, VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT, VK_PIPELINE_STAGE_FRAGMENT_SHADER_BIT, VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT,
+             VK_ACCESS_INPUT_ATTACHMENT_READ_BIT, VK_DEPENDENCY_BY_REGION_BIT},
+            {0, VK_SUBPASS_EXTERNAL, VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT, VK_PIPELINE_STAGE_HOST_BIT,
+             VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT, VK_ACCESS_HOST_READ_BIT, 0}};
+        VkRenderPassCreateInfo rp = {VK_STRUCTURE_TYPE_RENDER_PASS_CREATE_INFO};
+        rp.attachmentCount = 1;
+        rp.pAttachments = &attachment;
+        rp.subpassCount = 1;
+        rp.pSubpasses = &subpass;
+        rp.dependencyCount = 2;
+        rp.pDependencies = deps;
+        if (d.vkCreateRenderPass(d.device, &rp, nullptr, &pass) != VK_SUCCESS) {failed = 20; break;}
+        VkFramebufferCreateInfo fb = {VK_STRUCTURE_TYPE_FRAMEBUFFER_CREATE_INFO};
+        fb.renderPass = pass;
+        fb.attachmentCount = 1;
+        fb.pAttachments = &t.view;
+        fb.width = kWidth;
+        fb.height = kHeight;
+        fb.layers = 1;
+        if (d.vkCreateFramebuffer(d.device, &fb, nullptr, &framebuffer) != VK_SUCCESS) {failed = 21; break;}
+        vs = shaderModule(d, kSpv_smoke_swap_vert, sizeof kSpv_smoke_swap_vert);
+        fsConst = shaderModule(d, kSpv_smoke_triangle_frag, sizeof kSpv_smoke_triangle_frag);
+        fsFetch = shaderModule(d, kSpv_smoke_swap_fetch_frag, sizeof kSpv_smoke_swap_fetch_frag);
+        if (!vs || !fsConst || !fsFetch) {failed = 22; break;}
+        VkDescriptorSetLayoutBinding binding = {0, VK_DESCRIPTOR_TYPE_INPUT_ATTACHMENT, 1, VK_SHADER_STAGE_FRAGMENT_BIT, nullptr};
+        VkDescriptorSetLayoutCreateInfo sl = {VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO};
+        sl.bindingCount = 1;
+        sl.pBindings = &binding;
+        if (d.vkCreateDescriptorSetLayout(d.device, &sl, nullptr, &setLayout) != VK_SUCCESS) {failed = 23; break;}
+        VkPushConstantRange push = {VK_SHADER_STAGE_FRAGMENT_BIT, 0, 16};
+        VkPipelineLayoutCreateInfo pl = {VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO};
+        pl.setLayoutCount = 1;
+        pl.pSetLayouts = &setLayout;
+        pl.pushConstantRangeCount = 1;
+        pl.pPushConstantRanges = &push;
+        if (d.vkCreatePipelineLayout(d.device, &pl, nullptr, &layout) != VK_SUCCESS) {failed = 24; break;}
+        VkDescriptorPoolSize size = {VK_DESCRIPTOR_TYPE_INPUT_ATTACHMENT, 1};
+        VkDescriptorPoolCreateInfo dp = {VK_STRUCTURE_TYPE_DESCRIPTOR_POOL_CREATE_INFO};
+        dp.maxSets = 1;
+        dp.poolSizeCount = 1;
+        dp.pPoolSizes = &size;
+        if (d.vkCreateDescriptorPool(d.device, &dp, nullptr, &pool) != VK_SUCCESS) {failed = 25; break;}
+        VkDescriptorSetAllocateInfo da = {VK_STRUCTURE_TYPE_DESCRIPTOR_SET_ALLOCATE_INFO};
+        da.descriptorPool = pool;
+        da.descriptorSetCount = 1;
+        da.pSetLayouts = &setLayout;
+        VkDescriptorSet set = nullptr;
+        if (d.vkAllocateDescriptorSets(d.device, &da, &set) != VK_SUCCESS) {failed = 25; break;}
+        VkDescriptorImageInfo image = {nullptr, t.view, VK_IMAGE_LAYOUT_GENERAL};
+        VkWriteDescriptorSet write = {VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET};
+        write.dstSet = set;
+        write.descriptorCount = 1;
+        write.descriptorType = VK_DESCRIPTOR_TYPE_INPUT_ATTACHMENT;
+        write.pImageInfo = &image;
+        d.vkUpdateDescriptorSets(d.device, 1, &write, 0, nullptr);
+
+        VkPipelineVertexInputStateCreateInfo vi = {VK_STRUCTURE_TYPE_PIPELINE_VERTEX_INPUT_STATE_CREATE_INFO};
+        VkPipelineInputAssemblyStateCreateInfo ia = {VK_STRUCTURE_TYPE_PIPELINE_INPUT_ASSEMBLY_STATE_CREATE_INFO};
+        ia.topology = VK_PRIMITIVE_TOPOLOGY_TRIANGLE_LIST;
+        VkPipelineViewportStateCreateInfo vp = {VK_STRUCTURE_TYPE_PIPELINE_VIEWPORT_STATE_CREATE_INFO};
+        vp.viewportCount = 1;
+        vp.scissorCount = 1;
+        VkPipelineRasterizationStateCreateInfo rs = {VK_STRUCTURE_TYPE_PIPELINE_RASTERIZATION_STATE_CREATE_INFO};
+        rs.polygonMode = VK_POLYGON_MODE_FILL;
+        rs.cullMode = VK_CULL_MODE_NONE;
+        rs.lineWidth = 1.0f;
+        VkPipelineMultisampleStateCreateInfo ms = {VK_STRUCTURE_TYPE_PIPELINE_MULTISAMPLE_STATE_CREATE_INFO};
+        ms.rasterizationSamples = VK_SAMPLE_COUNT_1_BIT;
+        VkPipelineColorBlendAttachmentState blend = {};
+        blend.colorWriteMask = 0xf;
+        VkPipelineColorBlendStateCreateInfo cb = {VK_STRUCTURE_TYPE_PIPELINE_COLOR_BLEND_STATE_CREATE_INFO};
+        cb.attachmentCount = 1;
+        cb.pAttachments = &blend;
+        const VkDynamicState dynamic[2] = {VK_DYNAMIC_STATE_VIEWPORT, VK_DYNAMIC_STATE_SCISSOR};
+        VkPipelineDynamicStateCreateInfo dyn = {VK_STRUCTURE_TYPE_PIPELINE_DYNAMIC_STATE_CREATE_INFO};
+        dyn.dynamicStateCount = 2;
+        dyn.pDynamicStates = dynamic;
+        VkPipelineShaderStageCreateInfo stages[2] = {
+            {VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO, nullptr, 0, VK_SHADER_STAGE_VERTEX_BIT, vs, "main", nullptr},
+            {VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO, nullptr, 0, VK_SHADER_STAGE_FRAGMENT_BIT, fsConst, "main", nullptr}};
+        VkGraphicsPipelineCreateInfo gp = {VK_STRUCTURE_TYPE_GRAPHICS_PIPELINE_CREATE_INFO};
+        gp.stageCount = 2;
+        gp.pStages = stages;
+        gp.pVertexInputState = &vi;
+        gp.pInputAssemblyState = &ia;
+        gp.pViewportState = &vp;
+        gp.pRasterizationState = &rs;
+        gp.pMultisampleState = &ms;
+        gp.pColorBlendState = &cb;
+        gp.pDynamicState = &dyn;
+        gp.layout = layout;
+        gp.renderPass = pass;
+        if (d.vkCreateGraphicsPipelines(d.device, nullptr, 1, &gp, nullptr, &drawPipe) != VK_SUCCESS) {failed = 26; break;}
+        stages[1].module = fsFetch;
+        if (d.vkCreateGraphicsPipelines(d.device, nullptr, 1, &gp, nullptr, &fetchPipe) != VK_SUCCESS) {failed = 27; break;}
+
+        if (d.begin() != VK_SUCCESS) {failed = 28; break;}
+        VkBufferImageCopy copy = {};
+        copy.imageSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1};
+        copy.imageExtent = {kWidth, kHeight, 1};
+        f.vkCmdCopyBufferToImage(d.cmd, upload.buffer, t.image, VK_IMAGE_LAYOUT_GENERAL, 1, &copy);
+        VkMemoryBarrier filled = {VK_STRUCTURE_TYPE_MEMORY_BARRIER, nullptr, VK_ACCESS_TRANSFER_WRITE_BIT,
+                                  VK_ACCESS_COLOR_ATTACHMENT_READ_BIT | VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT};
+        d.vkCmdPipelineBarrier(d.cmd, VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT, 0, 1, &filled, 0, nullptr,
+                               0, nullptr);
+        VkRenderPassBeginInfo rb = {VK_STRUCTURE_TYPE_RENDER_PASS_BEGIN_INFO};
+        rb.renderPass = pass;
+        rb.framebuffer = framebuffer;
+        rb.renderArea = {{0, 0}, {kWidth, kHeight}};
+        d.vkCmdBeginRenderPass(d.cmd, &rb, VK_SUBPASS_CONTENTS_INLINE);
+        const VkViewport viewport = {0, 0, float(kWidth), float(kHeight), 0, 1};
+        f.vkCmdSetViewport(d.cmd, 0, 1, &viewport);
+        d.vkCmdBindPipeline(d.cmd, VK_PIPELINE_BIND_POINT_GRAPHICS, drawPipe);
+        const float drawn[4] = {0.8f, 0.4f, 0.2f, 1.0f};
+        d.vkCmdPushConstants(d.cmd, layout, VK_SHADER_STAGE_FRAGMENT_BIT, 0, sizeof drawn, drawn);
+        const VkRect2D a = {{0, 0}, {1016, kHeight}}, dRegion = {{2032, 32}, {1016, 32}}, cd = {{2032, 0}, {1016, kHeight}};
+        f.vkCmdSetScissor(d.cmd, 0, 1, &a);
+        d.vkCmdDraw(d.cmd, 3, 1, 0, 0);
+        f.vkCmdSetScissor(d.cmd, 0, 1, &dRegion);
+        d.vkCmdDraw(d.cmd, 3, 1, 0, 0);
+        VkMemoryBarrier barrier = {VK_STRUCTURE_TYPE_MEMORY_BARRIER, nullptr, VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT,
+                                   VK_ACCESS_INPUT_ATTACHMENT_READ_BIT};
+        d.vkCmdPipelineBarrier(d.cmd, VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT, VK_PIPELINE_STAGE_FRAGMENT_SHADER_BIT,
+                               VK_DEPENDENCY_BY_REGION_BIT, 1, &barrier, 0, nullptr, 0, nullptr);
+        d.vkCmdBindPipeline(d.cmd, VK_PIPELINE_BIND_POINT_GRAPHICS, fetchPipe);
+        d.vkCmdBindDescriptorSets(d.cmd, VK_PIPELINE_BIND_POINT_GRAPHICS, layout, 0, 1, &set, 0, nullptr);
+        f.vkCmdSetScissor(d.cmd, 0, 1, &cd);
+        d.vkCmdDraw(d.cmd, 3, 1, 0, 0);
+        d.vkCmdEndRenderPass(d.cmd);
+        VkMemoryBarrier stored = {VK_STRUCTURE_TYPE_MEMORY_BARRIER, nullptr, VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT, VK_ACCESS_TRANSFER_READ_BIT};
+        d.vkCmdPipelineBarrier(d.cmd, VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT, VK_PIPELINE_STAGE_TRANSFER_BIT, 0, 1, &stored, 0, nullptr,
+                               0, nullptr);
+        d.vkCmdCopyImageToBuffer(d.cmd, t.image, VK_IMAGE_LAYOUT_GENERAL, staging.buffer, 1, &copy);
+        hostBarrier(d, VK_PIPELINE_STAGE_TRANSFER_BIT, VK_ACCESS_TRANSFER_WRITE_BIT);
+        if (d.vkEndCommandBuffer(d.cmd) != VK_SUCCESS) {failed = 28; break;}
+        if (d.submitAndWait() != VK_SUCCESS) {failed = 29; break;}
+    } while (false);
+    if (fetchPipe) d.vkDestroyPipeline(d.device, fetchPipe, nullptr);
+    if (drawPipe) d.vkDestroyPipeline(d.device, drawPipe, nullptr);
+    if (pool) d.vkDestroyDescriptorPool(d.device, pool, nullptr);
+    if (layout) d.vkDestroyPipelineLayout(d.device, layout, nullptr);
+    if (setLayout) d.vkDestroyDescriptorSetLayout(d.device, setLayout, nullptr);
+    if (vs) d.vkDestroyShaderModule(d.device, vs, nullptr);
+    if (fsConst) d.vkDestroyShaderModule(d.device, fsConst, nullptr);
+    if (fsFetch) d.vkDestroyShaderModule(d.device, fsFetch, nullptr);
+    if (framebuffer) d.vkDestroyFramebuffer(d.device, framebuffer, nullptr);
+    if (pass) d.vkDestroyRenderPass(d.device, pass, nullptr);
+    return failed;
+}
+
+// Runs every kind and mode and hands each result line to report.
+template <typename Report>
+static void run(const char *libraryPath, Report &&report) {
+    char line[96];
+    void *lib = dlopen(libraryPath, RTLD_NOW | RTLD_LOCAL);
+    auto setMode = lib ? reinterpret_cast<void (*)(char)>(dlsym(lib, "tu_sheng_set_thread_render_mode")) : nullptr;
+    auto gipa = lib ? reinterpret_cast<PFN_vkGetInstanceProcAddr>(dlsym(lib, "vk_icdGetInstanceProcAddr")) : nullptr;
+    if (!setMode || !gipa) {report("swap setup e1"); return;}
+    auto createInstance = reinterpret_cast<PFN_vkCreateInstance>(gipa(nullptr, "vkCreateInstance"));
+    VkApplicationInfo app = {VK_STRUCTURE_TYPE_APPLICATION_INFO};
+    app.pApplicationName = "NativeAdrenoSwapTest";
+    app.apiVersion = VK_API_VERSION_1_1;
+    VkInstanceCreateInfo ici = {VK_STRUCTURE_TYPE_INSTANCE_CREATE_INFO};
+    ici.pApplicationInfo = &app;
+    VkInstance instance = nullptr;
+    if (!createInstance || createInstance(&ici, nullptr, &instance) != VK_SUCCESS) {report("swap setup e2"); return;}
+    auto enumerate = reinterpret_cast<PFN_vkEnumeratePhysicalDevices>(gipa(instance, "vkEnumeratePhysicalDevices"));
+    auto memoryProps = reinterpret_cast<PFN_vkGetPhysicalDeviceMemoryProperties>(gipa(instance, "vkGetPhysicalDeviceMemoryProperties"));
+    auto extensions = reinterpret_cast<PFN_vkEnumerateDeviceExtensionProperties>(gipa(instance, "vkEnumerateDeviceExtensionProperties"));
+    auto createDevice = reinterpret_cast<PFN_vkCreateDevice>(gipa(instance, "vkCreateDevice"));
+    auto deviceProc = reinterpret_cast<PFN_vkGetDeviceProcAddr>(gipa(instance, "vkGetDeviceProcAddr"));
+    auto destroyInstance = reinterpret_cast<PFN_vkDestroyInstance>(gipa(instance, "vkDestroyInstance"));
+    uint32_t count = 1;
+    VkPhysicalDevice physical = nullptr;
+    if (!enumerate || !memoryProps || !extensions || !createDevice || !deviceProc ||
+        enumerate(instance, &count, &physical) < 0 || !physical) {report("swap setup e3"); return;}
+    bool hostImport = false;
+    uint32_t extensionCount = 0;
+    extensions(physical, nullptr, &extensionCount, nullptr);
+    VkExtensionProperties ext[256];
+    if (extensionCount > 256) extensionCount = 256;
+    extensions(physical, nullptr, &extensionCount, ext);
+    for (uint32_t i = 0; i < extensionCount; ++i)
+        hostImport |= !strcmp(ext[i].extensionName, VK_EXT_EXTERNAL_MEMORY_HOST_EXTENSION_NAME);
+    float priority = 1.0f;
+    VkDeviceQueueCreateInfo qci = {VK_STRUCTURE_TYPE_DEVICE_QUEUE_CREATE_INFO};
+    qci.queueCount = 1;
+    qci.pQueuePriorities = &priority;
+    const char *wanted[] = {VK_EXT_EXTERNAL_MEMORY_HOST_EXTENSION_NAME};
+    VkDeviceCreateInfo dci = {VK_STRUCTURE_TYPE_DEVICE_CREATE_INFO};
+    dci.queueCreateInfoCount = 1;
+    dci.pQueueCreateInfos = &qci;
+    dci.enabledExtensionCount = hostImport ? 1 : 0;
+    dci.ppEnabledExtensionNames = wanted;
+    Device d;
+    if (createDevice(physical, &dci, nullptr, &d.device) != VK_SUCCESS) {report("swap setup e4"); destroyInstance(instance, nullptr); return;}
+    bool resolved = true;
+#define SWAP_RESOLVE(name) d.name = reinterpret_cast<PFN_##name>(deviceProc(d.device, #name)); resolved &= d.name != nullptr;
+    TURNIP_DEVICE_FNS(SWAP_RESOLVE)
+#undef SWAP_RESOLVE
+    Fns f;
+    f.vkGetImageSubresourceLayout = reinterpret_cast<PFN_vkGetImageSubresourceLayout>(deviceProc(d.device, "vkGetImageSubresourceLayout"));
+    f.vkCmdSetScissor = reinterpret_cast<PFN_vkCmdSetScissor>(deviceProc(d.device, "vkCmdSetScissor"));
+    f.vkCmdSetViewport = reinterpret_cast<PFN_vkCmdSetViewport>(deviceProc(d.device, "vkCmdSetViewport"));
+    f.vkCmdCopyBufferToImage = reinterpret_cast<PFN_vkCmdCopyBufferToImage>(deviceProc(d.device, "vkCmdCopyBufferToImage"));
+    if (hostImport)
+        f.vkGetMemoryHostPointerPropertiesEXT =
+            reinterpret_cast<PFN_vkGetMemoryHostPointerPropertiesEXT>(deviceProc(d.device, "vkGetMemoryHostPointerPropertiesEXT"));
+    memoryProps(physical, &d.memory);
+    d.vkGetDeviceQueue(d.device, 0, 0, &d.queue);
+    VkCommandPoolCreateInfo pci = {VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO};
+    pci.flags = VK_COMMAND_POOL_CREATE_RESET_COMMAND_BUFFER_BIT;
+    VkCommandBufferAllocateInfo cai = {VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO};
+    cai.level = VK_COMMAND_BUFFER_LEVEL_PRIMARY;
+    cai.commandBufferCount = 1;
+    HostBuffer staging, upload;
+    if (!resolved || !f.vkGetImageSubresourceLayout || !f.vkCmdSetScissor || !f.vkCmdSetViewport || !f.vkCmdCopyBufferToImage ||
+        d.vkCreateCommandPool(d.device, &pci, nullptr, &d.pool) != VK_SUCCESS ||
+        (cai.commandPool = d.pool, d.vkAllocateCommandBuffers(d.device, &cai, &d.cmd)) != VK_SUCCESS) {
+        report("swap setup e5");
+    } else if (staging.create(d, kWidth * kHeight * 4, VK_BUFFER_USAGE_TRANSFER_DST_BIT) != VK_SUCCESS ||
+               upload.create(d, kWidth * kHeight * 4, VK_BUFFER_USAGE_TRANSFER_SRC_BIT) != VK_SUCCESS) {
+        report("swap setup e6");
+    } else {
+        for (int kind = 0; kind < 2; ++kind) {
+            if (kind == 1 && !hostImport) {report("swap host unsupported"); continue;}
+            for (const char mode : {'s', 'g'}) {
+                Target t;
+                int error = makeTarget(d, f, kind == 1, t);
+                if (!error) {
+                    setMode(mode);
+                    error = renderOnce(d, f, t, upload, staging);
+                    setMode(0);
+                }
+                auto px = [&](uint32_t x, uint32_t y) {
+                    static char out[4][8];
+                    static int slot;
+                    char *s = out[slot++ & 3];
+                    const uint8_t *p = reinterpret_cast<const uint8_t *>(const_cast<const uint32_t *>(staging.words)) + (y * kWidth + x) * 4;
+                    snprintf(s, 8, "%02x%02x%02x", p[0], p[1], p[2]);
+                    return s;
+                };
+                snprintf(line, sizeof line, "swap %s%c A%s B%s C%s D%s p%u e%d", kind ? "host" : "dev", mode, px(508, 32), px(1524, 32),
+                         px(2540, 16), px(2540, 48), unsigned(t.pitch), error);
+                report(line);
+                destroy(d, t);
+            }
+        }
+        d.vkDeviceWaitIdle(d.device);
+        staging.destroy(d);
+        upload.destroy(d);
+        d.vkDestroyCommandPool(d.device, d.pool, nullptr);
+    }
+    d.vkDestroyDevice(d.device, nullptr);
+    destroyInstance(instance, nullptr);
+}
+
+}  // namespace swaptest
+}  // namespace turnip
+#pragma clang diagnostic pop
diff --git a/QueuePriority.h b/QueuePriority.h
new file mode 100644
index 0000000..c76ddc2
--- /dev/null
+++ b/QueuePriority.h
@@ -0,0 +1,21 @@
+// SPDX-License-Identifier: MIT
+#pragma once
+#include <cstddef>
+#include <cstdint>
+// Logical Metal queues share one Vulkan queue. Count current requests, including
+// defaults, so lowering or destroying a queue releases its priority boost.
+class NBQueuePriorities {
+    size_t counts_[2][6]{};
+public:
+    struct Request {uint32_t foreground=1,background=3;};
+    static bool valid(uint32_t p,bool background) {return p<6 && (background || p!=3);}
+    void add(Request r) {++counts_[0][r.foreground];++counts_[1][r.background];}
+    void remove(Request r) {--counts_[0][r.foreground];--counts_[1][r.background];}
+    Request aggregate() const {
+        const uint32_t order[]={5,4,0,1,2,3};
+        Request out;
+        for(auto p:order)if(counts_[0][p]){out.foreground=p;break;}
+        for(auto p:order)if(counts_[1][p]){out.background=p;break;}
+        return out;
+    }
+};
diff --git a/SharedShaderCache.h b/SharedShaderCache.h
new file mode 100644
index 0000000..f02320e
--- /dev/null
+++ b/SharedShaderCache.h
@@ -0,0 +1,42 @@
+// SPDX-License-Identifier: MIT
+#pragma once
+#include <string>
+#include <pwd.h>
+#include <unistd.h>
+#include <sys/stat.h>
+#include <stdlib.h>
+#include <vector>
+
+// Processes of one user share immutable, version-keyed shader entries. A sandbox
+// that cannot write this directory continues with its container's cache.
+inline std::string sharedShaderCacheDirectory() {
+    static const std::string path = []() -> std::string {
+        std::string root;
+        if (const char *override = getenv("NATIVE_METAL_SHARED_CACHE_DIR")) {
+            if (!*override) return {};
+            root = override;
+        } else {
+            passwd user{}, *found=nullptr;
+            std::vector<char> bytes(16384);
+            if (getpwuid_r(getuid(), &user, bytes.data(), bytes.size(), &found) || !found || !user.pw_dir) return {};
+            root = std::string(user.pw_dir) + "/Library/Caches/org.unixnu.metal";
+        }
+        mkdir(root.c_str(), 0700);
+        struct stat st = {};
+        if (lstat(root.c_str(), &st) || !S_ISDIR(st.st_mode) || st.st_uid != getuid() || (st.st_mode & 0022)) return {};
+        std::string probe = root + "/.write-XXXXXX";
+        int fd = mkstemp(probe.data());
+        if (fd < 0) return {};
+        close(fd); unlink(probe.c_str());
+        return root;
+    }();
+    return path;
+}
+
+// Call before the first Vulkan device is opened, including the optional smoke path.
+inline void configureShaderDiskCache(const std::string &root) {
+    if (root.empty()) return;
+    const std::string ir3 = root + "/ir3";
+    mkdir(ir3.c_str(), 0700);
+    if (access(ir3.c_str(), W_OK) == 0) setenv("MESA_SHADER_CACHE_DIR", ir3.c_str(), 0);
+}
diff --git a/bridge/RustPacBoundary.c b/bridge/RustPacBoundary.c
new file mode 100644
index 0000000..7a190db
--- /dev/null
+++ b/bridge/RustPacBoundary.c
@@ -0,0 +1,115 @@
+// SPDX-License-Identifier: MIT
+// The boundary between the Rust bridge and the rest of an arm64e process (iPadOS 27's render server). rustc compiles arm64e code without
+// pointer authentication: it calls every function pointer with a plain blr/br and hands out unsigned function pointers. The rest of the
+// process signs function pointers (IA key, discriminator 0) and authenticates them at each indirect call, so neither side's pointers work
+// in the other's calls. Two fixes, both only in the arm64e plugin:
+//  - Rust -> C: scripts/rust-pac-rewrite.py turns every blr/br Xn in the linked Rust code into bl/b nmb_pac_call_xN below, which strips
+//    the signature (xpaci) and branches; an unsigned pointer passes unchanged. TLS thunks, dlsym results, Vulkan entry points and the
+//    plugin's callbacks are all called this way.
+//  - C -> Rust: the imports that take a Rust callback are renamed in the Rust objects (build-adreno-metal-plugin.py) to the nmb_pac_*
+//    wrappers below, which sign the callback before handing it on. Vulkan's debug messenger callback is signed in the create calls,
+//    reached through the wrapped vkGetInstanceProcAddr.
+#include <ptrauth.h>
+#include <dlfcn.h>
+#include <pthread.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unwind.h>
+#include <mach-o/dyld.h>
+#include <vulkan/vulkan.h>
+
+#define NMB_STRIP(f) ptrauth_strip((void *)(f), ptrauth_key_function_pointer)
+#define NMB_SIGN(f) ptrauth_sign_unauthenticated(NMB_STRIP(f), ptrauth_key_function_pointer, 0)
+
+// ---- Rust -> C: one trampoline per register (x30 is the link register and is never a target here) ----
+#define NMB_CALL(n) __attribute__((naked, used, visibility("default"))) void nmb_pac_call_x##n(void) \
+    {__asm__ volatile("xpaci x" #n "\n\tbr x" #n);}
+NMB_CALL(0) NMB_CALL(1) NMB_CALL(2) NMB_CALL(3) NMB_CALL(4) NMB_CALL(5) NMB_CALL(6) NMB_CALL(7) NMB_CALL(8) NMB_CALL(9)
+NMB_CALL(10) NMB_CALL(11) NMB_CALL(12) NMB_CALL(13) NMB_CALL(14) NMB_CALL(15) NMB_CALL(16) NMB_CALL(17) NMB_CALL(18) NMB_CALL(19)
+NMB_CALL(20) NMB_CALL(21) NMB_CALL(22) NMB_CALL(23) NMB_CALL(24) NMB_CALL(25) NMB_CALL(26) NMB_CALL(27) NMB_CALL(28) NMB_CALL(29)
+
+// ---- C -> Rust: imports that take a Rust callback ----
+// The callback parameters are taken as void * so the compiler neither authenticates nor re-signs the unsigned bits Rust passed.
+int nmb_pac_pthread_create(pthread_t *thread, const pthread_attr_t *attr, void *start, void *arg)
+{
+    return pthread_create(thread, attr, (void *(*)(void *))NMB_SIGN(start), arg);
+}
+void nmb_pac_tlv_atexit(void *destructor, void *object)
+{
+    _tlv_atexit((void (*)(void *))NMB_SIGN(destructor), object);
+}
+int nmb_pac_atexit(void *function)
+{
+    return atexit((void (*)(void))NMB_SIGN(function));
+}
+void nmb_pac_dyld_register_func_for_add_image(void *function)
+{
+    _dyld_register_func_for_add_image((void (*)(const struct mach_header *, intptr_t))NMB_SIGN(function));
+}
+_Unwind_Reason_Code nmb_pac_Unwind_Backtrace(void *trace, void *context)
+{
+    return _Unwind_Backtrace((_Unwind_Trace_Fn)NMB_SIGN(trace), context);
+}
+
+// ---- Vulkan: the debug messenger callback the runtime installs ----
+static PFN_vkGetInstanceProcAddr gGetInstanceProcAddr;
+static PFN_vkCreateInstance gCreateInstance;
+static PFN_vkCreateDebugUtilsMessengerEXT gCreateMessenger;
+// Signs every messenger callback in a pNext chain in place; returns the original values for restore (at most 8 messengers).
+static unsigned signChain(const void *next, void **saved, unsigned cap)
+{
+    unsigned count = 0;
+    for (VkBaseOutStructure *s = (VkBaseOutStructure *)next; s && count < cap; s = s->pNext) {
+        if (s->sType != VK_STRUCTURE_TYPE_DEBUG_UTILS_MESSENGER_CREATE_INFO_EXT) continue;
+        VkDebugUtilsMessengerCreateInfoEXT *info = (VkDebugUtilsMessengerCreateInfoEXT *)s;
+        saved[count++] = (void *)info->pfnUserCallback;
+        if (info->pfnUserCallback) info->pfnUserCallback = (PFN_vkDebugUtilsMessengerCallbackEXT)NMB_SIGN(info->pfnUserCallback);
+    }
+    return count;
+}
+static void restoreChain(const void *next, void **saved, unsigned count)
+{
+    unsigned at = 0;
+    for (VkBaseOutStructure *s = (VkBaseOutStructure *)next; s && at < count; s = s->pNext)
+        if (s->sType == VK_STRUCTURE_TYPE_DEBUG_UTILS_MESSENGER_CREATE_INFO_EXT)
+            ((VkDebugUtilsMessengerCreateInfoEXT *)s)->pfnUserCallback = (PFN_vkDebugUtilsMessengerCallbackEXT)saved[at++];
+}
+static VkResult wrapCreateInstance(const VkInstanceCreateInfo *info, const VkAllocationCallbacks *allocator, VkInstance *instance)
+{
+    void *saved[8];
+    const unsigned count = info ? signChain(info->pNext, saved, 8) : 0;
+    const VkResult result = gCreateInstance(info, allocator, instance);
+    if (info) restoreChain(info->pNext, saved, count);
+    return result;
+}
+static VkResult wrapCreateMessenger(VkInstance instance, const VkDebugUtilsMessengerCreateInfoEXT *info,
+                                    const VkAllocationCallbacks *allocator, VkDebugUtilsMessengerEXT *messenger)
+{
+    if (!info) return gCreateMessenger(instance, info, allocator, messenger);
+    VkDebugUtilsMessengerCreateInfoEXT copy = *info;
+    if (copy.pfnUserCallback) copy.pfnUserCallback = (PFN_vkDebugUtilsMessengerCallbackEXT)NMB_SIGN(copy.pfnUserCallback);
+    return gCreateMessenger(instance, &copy, allocator, messenger);
+}
+static PFN_vkVoidFunction wrapGetInstanceProcAddr(VkInstance instance, const char *name)
+{
+    if (!name) return NULL;
+    if (!strcmp(name, "vkGetInstanceProcAddr")) return (PFN_vkVoidFunction)wrapGetInstanceProcAddr;
+    PFN_vkVoidFunction real = gGetInstanceProcAddr(instance, name);
+    if (!real) return NULL;
+    if (!strcmp(name, "vkCreateInstance")) {gCreateInstance = (PFN_vkCreateInstance)real; return (PFN_vkVoidFunction)wrapCreateInstance;}
+    if (!strcmp(name, "vkCreateDebugUtilsMessengerEXT")) {
+        gCreateMessenger = (PFN_vkCreateDebugUtilsMessengerEXT)real;
+        return (PFN_vkVoidFunction)wrapCreateMessenger;
+    }
+    return real;
+}
+void *nmb_pac_dlsym(void *handle, const char *name)
+{
+    void *symbol = dlsym(handle, name);
+    if (symbol && name && (!strcmp(name, "vkGetInstanceProcAddr") || !strcmp(name, "vk_icdGetInstanceProcAddr"))) {
+        gGetInstanceProcAddr = (PFN_vkGetInstanceProcAddr)symbol;
+        return (void *)wrapGetInstanceProcAddr;
+    }
+    return symbol;
+}
diff --git a/bridge/coreimage_host.mm b/bridge/coreimage_host.mm
new file mode 100644
index 0000000..af13c83
--- /dev/null
+++ b/bridge/coreimage_host.mm
@@ -0,0 +1,73 @@
+// SPDX-License-Identifier: MIT
+// Host instrument: the Mac's Core Image renders a filter chain through a CIContext over the native frontend's device (bridge over a host
+// Vulkan driver, MoltenVK on the Mac), as iconservicesagent does on the target. Core Image builds its programs through Metal (stitched
+// function graphs, run-time source, its kernel libraries); a program it cannot make ends in a null program. Prints PASS with the pixel it
+// read, or FAIL with the frontend's last problem. NMB_SYSTEM_DEVICE=1 runs the Mac's own device as the baseline. The Mac's Core Image is not
+// the target's: this names gaps, it qualifies nothing on iPadOS.
+#import <Foundation/Foundation.h>
+#import <Metal/Metal.h>
+#import <CoreImage/CoreImage.h>
+#include <cstdio>
+#include <cstring>
+#include "../NativeBridgeMetalFrontend.h"
+extern "C" size_t native_bridge_metal_telemetry(char *, size_t);
+
+static void onMissing(const char *cls, const char *sel) {std::fprintf(stderr, "missing selector: %s %s\n", cls, sel);}
+
+int main(int argc, char **argv) {
+    @autoreleasepool {
+        if (argc < 3) return 2;
+        id<MTLDevice> device = getenv("NMB_SYSTEM_DEVICE") ? MTLCreateSystemDefaultDevice() : native_bridge_metal_open(argv[1], argv[2], 0x6e6d63, onMissing);
+        if (!device) {std::printf("FAIL device\n"); return 1;}
+        // Core Image's DAG path on iPadOS 27 (CI::MetalDAGHelper::get_precompiled_kernel): a kernel of the Core Image kernel library by
+        // name, though the library names none. argv[3]: such a library (this Mac's ci_stdlib.metallib).
+        if (argc > 3) {
+            NSError *error = nil;
+            id<MTLLibrary> kernels = [device newLibraryWithURL:[NSURL fileURLWithPath:@(argv[3])] error:&error];
+            id<MTLFunction> add = [kernels newFunctionWithName:@"_add" constantValues:[MTLFunctionConstantValues new] error:&error];
+            std::printf("KERNELS library %s names %lu _add %s type %lu\n", kernels ? "yes" : "no", (unsigned long)kernels.functionNames.count,
+                        add ? "yes" : "no", (unsigned long)add.functionType);
+            if (!add) {std::printf("FAIL kernel by name\n"); return 1;}
+            // iPadOS 27's Core Image links a kernel only when its name is among the library's externFunctionNames (its TYPE 5 entries;
+            // Apple's Metal answers 228 for macOS 26.5.1's ci_stdlib).
+            NSArray *externs = [(id)kernels respondsToSelector:@selector(externFunctionNames)] ? [(id)kernels performSelector:@selector(externFunctionNames)] : nil;
+            std::printf("EXTERNS %lu\n", (unsigned long)[externs count]);
+            if (![externs containsObject:@"_add"]) {std::printf("FAIL extern function names\n"); return 1;}
+            // As Apple's Metal answers (macOS 26.5.1): no names, the kernel by name, function type 4.
+            if (kernels.functionNames.count || add.functionType != 4) {std::printf("FAIL kernel library answers\n"); return 1;}
+        }
+        id<MTLCommandQueue> queue = [device newCommandQueue];
+        CIContext *context = [CIContext contextWithMTLCommandQueue:queue options:@{kCIContextCacheIntermediates: @NO}];
+        if (!context) {std::printf("FAIL CIContext\n"); return 1;}
+        const NSUInteger side = 64;
+        MTLTextureDescriptor *d = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:MTLPixelFormatBGRA8Unorm width:side height:side mipmapped:NO];
+        d.usage = MTLTextureUsageRenderTarget | MTLTextureUsageShaderRead | MTLTextureUsageShaderWrite;
+        d.storageMode = MTLStorageModeShared;
+        id<MTLTexture> target = [device newTextureWithDescriptor:d];
+        // A solid colour through colour controls and a blur: a chain of stitchable kernels, then a separable blur.
+        CIImage *image = [[CIImage imageWithColor:[CIColor colorWithRed:0.8 green:0.2 blue:0.1]] imageByCroppingToRect:CGRectMake(0, 0, side, side)];
+        CIFilter *controls = [CIFilter filterWithName:@"CIColorControls"];
+        [controls setValue:image forKey:kCIInputImageKey];
+        [controls setValue:@1.2 forKey:kCIInputSaturationKey];
+        CIFilter *blur = [CIFilter filterWithName:@"CIGaussianBlur"];
+        [blur setValue:controls.outputImage forKey:kCIInputImageKey];
+        [blur setValue:@2 forKey:kCIInputRadiusKey];
+        CIImage *out = [blur.outputImage imageByCroppingToRect:CGRectMake(0, 0, side, side)];
+        id<MTLCommandBuffer> commands = [queue commandBuffer];
+        CGColorSpaceRef space = CGColorSpaceCreateWithName(kCGColorSpaceSRGB);
+        [context render:out toMTLTexture:target commandBuffer:commands bounds:CGRectMake(0, 0, side, side) colorSpace:space];
+        CGColorSpaceRelease(space);
+        [commands commit];
+        [commands waitUntilCompleted];
+        uint8_t pixel[4] = {};
+        [target getBytes:pixel bytesPerRow:side * 4 fromRegion:MTLRegionMake2D(side / 2, side / 2, 1, 1) mipmapLevel:0];
+        static char table[16384];
+        if (!getenv("NMB_SYSTEM_DEVICE")) {
+            native_bridge_metal_telemetry(table, sizeof table);
+            for (char *line = std::strtok(table, "\n"); line; line = std::strtok(nullptr, "\n")) std::printf("TELEMETRY %s\n", line);
+        }
+        const bool red = pixel[2] > 150 && pixel[1] < 120 && pixel[0] < 120;
+        std::printf("%s pixel bgra %u %u %u %u status %lu\n", red ? "PASS" : "FAIL", pixel[0], pixel[1], pixel[2], pixel[3], (unsigned long)commands.status);
+        return red ? 0 : 1;
+    }
+}
diff --git a/bridge/interface_regressions_host.mm b/bridge/interface_regressions_host.mm
new file mode 100644
index 0000000..00e4e8a
--- /dev/null
+++ b/bridge/interface_regressions_host.mm
@@ -0,0 +1,201 @@
+// SPDX-License-Identifier: MIT
+#import <Foundation/Foundation.h>
+#import <Metal/Metal.h>
+#include "../NativeBridgeMetalFrontend.h"
+#include "NativeMetalObjects.h"
+#include <cstdio>
+#include <vector>
+#include <atomic>
+#include <cstring>
+#include <unistd.h>
+#include <thread>
+#include <chrono>
+
+@interface NSObject (InterfaceChecks)
+- (void)newFunctionWithDescriptor:(MTLFunctionDescriptor *)d completionHandler:(void (^)(id<MTLFunction>,NSError *))handler;
+- (void)newComputePipelineStateWithDescriptor:(MTLComputePipelineDescriptor *)d completionHandler:(void (^)(id<MTLComputePipelineState>,NSError *))handler;
+- (id<MTLTexture>)newTextureWithBytesNoCopy:(void *)bytes length:(NSUInteger)length descriptor:(MTLTextureDescriptor *)d deallocator:(void (^)(void *,NSUInteger))deallocator;
+@end
+static unsigned missing;
+static void absent(const char *c,const char *s) {fprintf(stderr,"missing %s %s\n",c,s);++missing;}
+#define CHECK(x) do {if(!(x)){fprintf(stderr,"FAIL %d: %s\n",__LINE__,#x);return 1;}}while(0)
+static bool finish(id<MTLCommandBuffer> cb) {
+ [cb commit];[cb waitUntilCompleted];
+ if(cb.status!=MTLCommandBufferStatusCompleted)fprintf(stderr,"command failed: %s\n",cb.error.description.UTF8String);
+ return cb.status==MTLCommandBufferStatusCompleted;
+}
+static id<MTLTexture> texture(id<MTLDevice> d,NSUInteger samples=1) {
+ auto t=[MTLTextureDescriptor texture2DDescriptorWithPixelFormat:MTLPixelFormatRGBA8Unorm width:8 height:8 mipmapped:NO];
+ t.usage=MTLTextureUsageRenderTarget|MTLTextureUsageShaderRead|MTLTextureUsagePixelFormatView;
+ t.storageMode=MTLStorageModePrivate;t.sampleCount=samples;
+ if(samples>1)t.textureType=MTLTextureType2DMultisample;
+ return [d newTextureWithDescriptor:t];
+}
+static id<MTLBuffer> readback(id<MTLDevice> dev,id<MTLCommandBuffer> cb,id<MTLTexture> t) {
+ auto b=[dev newBufferWithLength:256 options:MTLResourceStorageModeShared];
+ auto e=[cb blitCommandEncoder];
+ [e copyFromTexture:t sourceSlice:0 sourceLevel:0 sourceOrigin:MTLOriginMake(0,0,0) sourceSize:MTLSizeMake(8,8,1)
+  toBuffer:b destinationOffset:0 destinationBytesPerRow:32 destinationBytesPerImage:256];[e endEncoding];return b;
+}
+int main(int argc,char **argv) {@autoreleasepool {
+ CHECK(argc==4);const bool defaults=!strcmp(argv[3],"default");
+ const bool single=defaults || !strcmp(argv[3],"single");
+ if(defaults)unsetenv("NATIVE_METAL_SINGLE_SAMPLE");
+ else setenv("NATIVE_METAL_SINGLE_SAMPLE",single?"1":"0",1);
+ id<MTLDevice> dev=native_bridge_metal_open(argv[1],argv[2],0,absent);CHECK(dev);
+ id<MTLCommandQueue> queue=[dev newCommandQueue];CHECK(queue);
+ // Automatic heaps reclaim their ranges while aliasable objects remain alive.
+ auto hd=[MTLHeapDescriptor new];hd.size=65536;hd.storageMode=MTLStorageModePrivate;
+ auto heap=[dev newHeapWithDescriptor:hd];CHECK(heap);
+ auto b=[heap newBufferWithLength:4096 options:MTLResourceStorageModePrivate];CHECK(b);
+ NSUInteger used=heap.usedSize;CHECK(used>=4096);[b makeAliasable];CHECK(b.isAliasable && heap.usedSize<used);
+ auto td=[MTLTextureDescriptor texture2DDescriptorWithPixelFormat:MTLPixelFormatRGBA8Unorm width:8 height:8 mipmapped:NO];
+ td.storageMode=MTLStorageModePrivate;td.usage=MTLTextureUsageShaderRead|MTLTextureUsagePixelFormatView;
+ auto ht=[heap newTextureWithDescriptor:td];CHECK(ht);used=heap.usedSize;
+ [ht makeAliasable];CHECK(ht.isAliasable && heap.usedSize<used);
+ // Zero is a real swizzle, not a marker for the identity.
+ td.swizzle=MTLTextureSwizzleChannelsMake(MTLTextureSwizzleZero,MTLTextureSwizzleZero,MTLTextureSwizzleZero,MTLTextureSwizzleZero);
+ auto zero=[dev newTextureWithDescriptor:td];CHECK(zero && zero.swizzle.red==MTLTextureSwizzleZero && zero.swizzle.alpha==MTLTextureSwizzleZero);
+ auto view=[zero newTextureViewWithPixelFormat:zero.pixelFormat textureType:zero.textureType levels:NSMakeRange(0,1) slices:NSMakeRange(0,1)
+  swizzle:MTLTextureSwizzleChannelsMake(MTLTextureSwizzleBlue,MTLTextureSwizzleGreen,MTLTextureSwizzleRed,MTLTextureSwizzleOne)];
+ CHECK(view && view.swizzle.red==MTLTextureSwizzleBlue && view.swizzle.alpha==MTLTextureSwizzleOne);
+ // Completion selectors deliver successes and errors; constants expose their actual names and indices.
+ size_t length=0;const void *air=nmb_function_constant_air(&length);
+ id<MTLLibrary> library=native_bridge_metal_library_with_air(air,length);CHECK(library);
+ auto function=[library newFunctionWithName:@"fcfold"];CHECK(function && function.functionConstantsDictionary.count);
+ for(NSString *name in function.functionConstantsDictionary) {
