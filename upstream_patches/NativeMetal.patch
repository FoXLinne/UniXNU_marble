diff --git a/shaders/smoke_swap.vert b/shaders/smoke_swap.vert
new file mode 100644
index 0000000..2c1aea2
--- /dev/null
+++ b/shaders/smoke_swap.vert
@@ -0,0 +1,6 @@
+#version 450
+// GMEM swap test: one triangle over the whole target; the scissor picks the region.
+void main() {
+    const vec2 p[3] = vec2[](vec2(-1.0, -1.0), vec2(3.0, -1.0), vec2(-1.0, 3.0));
+    gl_Position = vec4(p[gl_VertexIndex], 0.0, 1.0);
+}
diff --git a/shaders/smoke_swap_fetch.frag b/shaders/smoke_swap_fetch.frag
new file mode 100644
index 0000000..6ea8550
--- /dev/null
+++ b/shaders/smoke_swap_fetch.frag
@@ -0,0 +1,8 @@
+#version 450
+// GMEM swap test: the attachment's red, as read back through the input attachment, written as grey (immune to any store swap).
+layout(input_attachment_index = 0, set = 0, binding = 0) uniform subpassInput source;
+layout(location = 0) out vec4 color;
+void main() {
+    const float red = subpassLoad(source).r;
+    color = vec4(red, red, red, 1.0);
+}
