+// A read-only streambuf backed by an mmap of the file, so reading it does not
+// copy it onto the heap. UniXNU signs inside installd, whose jetsam memory
+// limit a heap copy of a large application binary would exceed.
+class MapBuffer : public std::streambuf {
+  private:
+    Map map_;
+
+  public:
+    MapBuffer(const std::string &path) {
+        if (Look(path)) {
+            map_.open(path, O_RDONLY, PROT_READ, MAP_PRIVATE);
+            char *base(static_cast<char *>(map_.data()));
+            setg(base, base, base + map_.size());
+        }
+    }
+
+    static bool Look(const std::string &path) {
+        struct stat info;
+        return stat(path.c_str(), &info) == 0 && S_ISREG(info.st_mode) && info.st_size != 0;
+    }
+
+    const void *data() const { return map_.data(); }
+    size_t size() const { return map_.size(); }
 };
 #endif // LDID_NOTOOLS
 
