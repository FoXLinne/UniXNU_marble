+#if defined(XNU_ROOT_STAGE_CACHE) && XNU_ROOT_STAGE_CACHE
+extern int native_root_block_authorized(dev_t);
+extern int native_root_block_cache_authorized(dev_t);
+extern int native_root_block_volume_device(const char *, dev_t *, char *, size_t);
+#else
 extern int native_verified_block_volume_device(const char *, dev_t *, char *, size_t);
+extern int native_verified_block_root_authorized(dev_t);
+#endif
+
+static int
+native_owner_cache_device_authorized(dev_t device, bool root)
+{
+#if defined(XNU_ROOT_STAGE_CACHE) && XNU_ROOT_STAGE_CACHE
+	return root ? native_root_block_authorized(device) : native_root_block_cache_authorized(device);
+#else
+	return native_verified_block_root_authorized(device);
+#endif
+}
+
+static int
+native_owner_cache_find_volume(const char *uuid, dev_t *device, char *path, size_t size)
+{
+#if defined(XNU_ROOT_STAGE_CACHE) && XNU_ROOT_STAGE_CACHE
+	return native_root_block_volume_device(uuid, device, path, size);
+#else
+	return native_verified_block_volume_device(uuid, device, path, size);
+#endif
+}
