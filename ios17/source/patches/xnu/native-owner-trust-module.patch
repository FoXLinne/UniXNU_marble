--- a/bsd/kern/kern_trustcache.c
+++ b/bsd/kern/kern_trustcache.c
@@ -493,6 +493,29 @@
 	trust_cache_runtime_ready = true;
 }
 
+
+#ifdef BCM2837
+/* Board-owned binaries use the runtime's engineering-module policy. */
+kern_return_t
+native_load_owner_trust_module(const uint8_t *module, size_t bytes)
+{
+    if (!module || !bytes || !trust_cache_runtime_ready || !trust_cache_rt) return KERN_FAILURE;
+    if (!trust_cache_rt->allowEngineeringTC) return KERN_DENIED;
+    TrustCache_t *cache = kalloc_type(TrustCache_t, Z_WAITOK_ZERO);
+    uint8_t *payload = kalloc_data(bytes, Z_WAITOK);
+    memcpy(payload, module, bytes);
+    lck_rw_lock_exclusive(&trust_cache_rt_lock);
+    TCReturn_t result = amfi->TrustCache.loadModule(trust_cache_rt, kTCTypeEngineering,
+        cache, (uintptr_t)payload, bytes);
+    lck_rw_unlock_exclusive(&trust_cache_rt_lock);
+    printf("Native owner trust module: %u/%u/%u\n", result.component, result.error, result.uniqueError);
+    if (result.error == kTCReturnSuccess) return KERN_SUCCESS;
+    kfree_data(payload, bytes);
+    kfree_type(TrustCache_t, cache);
+    return result.error == kTCReturnDuplicate ? KERN_ALREADY_IN_SET : KERN_FAILURE;
+}
+#endif
+
 static kern_return_t
 xnu_load_trust_cache(
